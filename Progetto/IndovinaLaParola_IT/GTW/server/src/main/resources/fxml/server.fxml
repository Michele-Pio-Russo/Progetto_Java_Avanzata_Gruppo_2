<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="indovinaparola.server.controller.ControllerServer"
            stylesheets="@../css/server.css">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label text="IndovinaLaParola - Pannello Amministratore" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="Server NON avviato" styleClass="status-label"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.55">

            <!-- PANNELLO SINISTRO: Documenti + Analisi + Classifica -->
            <VBox spacing="10" styleClass="panel">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                <Label text="Documenti da Analizzare" styleClass="section-title"/>

                <ListView fx:id="documentListView" prefHeight="100" styleClass="list-view"/>

                <HBox spacing="8">
                    <Button text="Seleziona file .txt" onAction="#handleSelectFiles"
                            styleClass="btn-secondary"/>
                    <Button text="Rimuovi tutti" onAction="#handleClearFiles"
                            styleClass="btn-danger"/>
                </HBox>

                <Separator/>

                <Label text="Analisi Term Frequency" styleClass="section-title"/>
                <HBox spacing="8">
                    <Button fx:id="analyzeBtn" text="Avvia Analisi"
                            onAction="#handleAnalyze" styleClass="btn-primary"/>
                    <Button fx:id="saveAnalysisBtn" text="Salva (.dat)"
                            onAction="#handleSaveAnalysis"
                            styleClass="btn-secondary" disable="true"/>
                    <Button fx:id="loadAnalysisBtn" text="Carica (.dat)"
                            onAction="#handleLoadAnalysis" styleClass="btn-secondary"/>
                </HBox>

                <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0"/>
                <Label fx:id="progressLabel" text="" styleClass="label-small" wrapText="true"/>

                <Label text="Risultati (parola - frequenza):" styleClass="label-small"/>
                <TableView fx:id="tfTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="wordColumn" text="Parola" prefWidth="180"/>
                        <TableColumn fx:id="freqColumn" text="Frequenza TF" prefWidth="150"/>
                    </columns>
                    <placeholder><Label text="Nessuna analisi caricata."/></placeholder>
                </TableView>

                <Separator/>

                <Label text="Classifica Giocatori" styleClass="section-title"/>
                <Button fx:id="refreshStatsBtn" text="Aggiorna Classifica"
                        onAction="#handleRefreshStats" styleClass="btn-secondary"/>
                <TableView fx:id="statsTableView" prefHeight="150">
                    <columns>
                        <TableColumn fx:id="statUserCol"  text="Utente"   prefWidth="110"/>
                        <TableColumn fx:id="statWinsCol"  text="Vinte"    prefWidth="60"/>
                        <TableColumn fx:id="statGamesCol" text="Giocate"  prefWidth="70"/>
                        <TableColumn fx:id="statAvgCol"   text="Tempo medio (ms)" prefWidth="130"/>
                    </columns>
                    <placeholder><Label text="Nessuna statistica."/></placeholder>
                </TableView>
            </VBox>

            <!-- PANNELLO DESTRO: Controllo Server + Log -->
            <VBox spacing="10" styleClass="panel">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                <Label text="Controllo Server" styleClass="section-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Porta:" styleClass="label-small"/>
                    <Label fx:id="portLabel" text="5000" styleClass="label-small"/>
                </HBox>
                <HBox spacing="8">
                    <Button fx:id="startServerBtn" text="Avvia Server"
                            onAction="#handleStartServer" styleClass="btn-primary"/>
                    <Button fx:id="stopServerBtn"  text="Ferma Server"
                            onAction="#handleStopServer"
                            styleClass="btn-danger" disable="true"/>
                </HBox>

                <Separator/>

                <Label text="Log di Sistema" styleClass="section-title"/>
                <TextArea fx:id="logArea" VBox.vgrow="ALWAYS"
                          editable="false" wrapText="true" styleClass="log-area"/>
                <Button text="Pulisci Log" onAction="#handleClearLog"
                        styleClass="btn-secondary"/>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>
