<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="indovinaparola.client.controller.ControllerGioco"
            stylesheets="@../css/client.css"
            styleClass="game-root">

    <!-- Top bar -->
    <top>
        <HBox styleClass="game-topbar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label text="IndovinaLaParola" styleClass="game-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="etichettaGiocatore" text="Giocatore: ?" styleClass="player-label"/>
            <Label text=" | " styleClass="player-label"/>
            <Label fx:id="etichettaStato" text="In attesa..." styleClass="state-label"/>
        </HBox>
    </top>

    <!-- Center: StackPane con 3 pannelli sovrapposti -->
    <center>
        <StackPane styleClass="game-stack">

            <!-- PANNELLO ATTESA -->
            <VBox fx:id="waitingPane" alignment="CENTER" spacing="18"
                  styleClass="waiting-pane">
                <padding><Insets top="60" right="40" bottom="60" left="40"/></padding>
                <Label text="..." styleClass="big-emoji"/>
                <Label text="In attesa dell'avversario..." styleClass="waiting-title"/>
                <Label fx:id="dettaglioAttesa"
                       text="Connesso. La partita inizia quando entrambi i giocatori sono pronti."
                       wrapText="true" alignment="CENTER" styleClass="waiting-detail"
                       maxWidth="380"/>
                <ProgressIndicator prefWidth="48" prefHeight="48"/>
            </VBox>

            <!-- PANNELLO GIOCO -->
            <VBox fx:id="gamePane" alignment="TOP_CENTER" spacing="14"
                  visible="false" managed="false">
                <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>

                <!-- Timer e Difficoltà -->
                <HBox alignment="CENTER" spacing=\"20\">
                    <HBox alignment="CENTER" spacing="10">
                        <Label text="Tempo:" styleClass="timer-label"/>
                        <Label fx:id="etichettaTimer" text="60" styleClass="timer-value"/>
                        <Label text="secondi" styleClass="timer-label"/>
                    </HBox>
                    <Label text="|" styleClass="timer-label"/>
                    <HBox alignment="CENTER" spacing="6">
                        <Label text="Difficoltà:" styleClass="section-label"/>
                        <Label fx:id="etichettaDifficolta" text="Medio" styleClass="difficulty-label"/>
                    </HBox>
                </HBox>

                <Separator/>

                <!-- Testo estratto -->
                <VBox spacing="4">
                    <Label text="Testo della sfida:" styleClass="section-label"/>
                    <TextArea fx:id="areaTesto" editable="false" wrapText="true"
                              prefHeight="200" styleClass="text-area-game"/>
                </VBox>

                <!-- Parola cifrata -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Parola cifrata:" styleClass="section-label"/>
                    <Label fx:id="etichettaParoleCifrate" text=""
                           styleClass="encrypted-words"/>
                </HBox>

                <!-- Input risposta -->
                <VBox spacing="6">
                    <Label text="La tua risposta:" styleClass="section-label"/>
                    <HBox spacing="10">
                        <TextField fx:id="campoRisposta"
                                   promptText="Scrivi qui la parola originale..."
                                   HBox.hgrow="ALWAYS" styleClass="answer-field"
                                   onAction="#gestisciInvioRisposta"/>
                        <Button text="Invia" onAction="#gestisciInvioRisposta"
                                styleClass="btn-submit"/>
                    </HBox>
                </VBox>

                <Label fx:id="etichettaFeedback" text="" styleClass="feedback-label"
                       wrapText="true"/>
            </VBox>

            <!-- PANNELLO RISULTATO -->
            <VBox fx:id="pannelloRisultato" alignment="CENTER" spacing="18"
                  visible="false" managed="false">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
                <Label fx:id="emojiRisultato" text="" styleClass="result-emoji"/>
                <Label fx:id="titoloRisultato" text="" styleClass="result-title"/>
                <Label fx:id="dettaglioRisultato" text="" wrapText="true"
                       alignment="CENTER" styleClass="result-detail" maxWidth="400"/>
                <HBox spacing="12" alignment="CENTER">
                    <Button text="Vedi Storico" onAction="#gestisciVisualizzaStorico"
                            styleClass="btn-secondary-game"/>
                    <Button text="Nuova Partita" onAction="#gestisciNuovaPartita"
                            styleClass="btn-primary-game"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
