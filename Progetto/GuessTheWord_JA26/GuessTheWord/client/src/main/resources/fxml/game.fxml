<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="guesstheword.client.controller.GameController"
            styleClass="game-root"
            stylesheets="@../css/client.css">

    <!-- TOP: status bar -->
    <top>
        <HBox styleClass="game-topbar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label text="🎮 GuessTheWord" styleClass="game-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="playerLabel" text="👤 ?" styleClass="player-label"/>
            <Label text="|" styleClass="separator-label"/>
            <Label fx:id="stateLabel" text="⏳ In attesa..." styleClass="state-label"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <!-- WAITING pane -->
            <VBox fx:id="waitingPane" alignment="CENTER" spacing="20" styleClass="waiting-pane">
                <Label text="⏳" styleClass="big-emoji"/>
                <Label text="In attesa dell'avversario..." styleClass="waiting-title"/>
                <Label fx:id="waitingDetail" text="Connesso al server. La partita inizierà quando entrambi i giocatori saranno pronti."
                       wrapText="true" alignment="CENTER" styleClass="waiting-detail"/>
                <ProgressIndicator styleClass="spinner"/>
            </VBox>

            <!-- GAME pane -->
            <VBox fx:id="gamePane" alignment="TOP_CENTER" spacing="16" visible="false" managed="false">
                <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

                <!-- Timer -->
                <HBox alignment="CENTER" spacing="15">
                    <Label text="⏱ Tempo rimanente:" styleClass="timer-label"/>
                    <Label fx:id="timerLabel" text="60" styleClass="timer-value"/>
                    <Label text="secondi" styleClass="timer-label"/>
                </HBox>

                <Separator/>

                <!-- Extracted text -->
                <VBox spacing="6">
                    <Label text="📄 Testo della sfida:" styleClass="section-label"/>
                    <TextArea fx:id="textArea" editable="false" wrapText="true"
                              prefHeight="220" styleClass="text-area-game"/>
                </VBox>

                <!-- Encrypted words hint -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="🔐 Parole cifrate:" styleClass="section-label"/>
                    <Label fx:id="encryptedWordsLabel" text="" styleClass="encrypted-words"/>
                </HBox>

                <!-- Answer input -->
                <VBox spacing="8">
                    <Label text="💡 La tua risposta:" styleClass="section-label"/>
                    <HBox spacing="10">
                        <TextField fx:id="answerField" promptText="Scrivi qui la parola originale..."
                                   HBox.hgrow="ALWAYS" styleClass="answer-field"
                                   onAction="#handleSubmitAnswer"/>
                        <Button text="📤 Invia" onAction="#handleSubmitAnswer"
                                styleClass="btn-submit"/>
                    </HBox>
                </VBox>

                <Label fx:id="feedbackLabel" text="" styleClass="feedback-label" wrapText="true"/>
            </VBox>

            <!-- RESULT pane -->
            <VBox fx:id="resultPane" alignment="CENTER" spacing="20" visible="false" managed="false">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
                <Label fx:id="resultEmoji" text="🏆" styleClass="result-emoji"/>
                <Label fx:id="resultTitle" text="Hai vinto!" styleClass="result-title"/>
                <Label fx:id="resultDetail" text="" wrapText="true"
                       alignment="CENTER" styleClass="result-detail"/>
                <Button text="📋 Vedi Storico" onAction="#handleViewHistory"
                        styleClass="btn-secondary-game"/>
                <Button text="🔄 Nuova Partita" onAction="#handleNewGame"
                        styleClass="btn-primary-game"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
