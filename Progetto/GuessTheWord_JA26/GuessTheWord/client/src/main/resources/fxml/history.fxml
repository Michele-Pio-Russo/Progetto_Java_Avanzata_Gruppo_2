<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="guesstheword.client.controller.HistoryController"
      spacing="14" styleClass="game-root"
      stylesheets="@../css/client.css">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="📋 Storico Partite" styleClass="section-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="← Torna al Gioco" onAction="#handleBack" styleClass="btn-secondary-game"/>
    </HBox>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="dateCol" text="Data/Ora" prefWidth="150"/>
            <TableColumn fx:id="opponentCol" text="Avversario" prefWidth="120"/>
            <TableColumn fx:id="outcomeCol" text="Esito" prefWidth="80"/>
            <TableColumn fx:id="wordCol" text="Parola" prefWidth="120"/>
            <TableColumn fx:id="timeCol" text="Tempo (ms)" prefWidth="110"/>
        </columns>
        <placeholder>
            <Label text="Nessuna partita registrata." styleClass="waiting-detail"/>
        </placeholder>
    </TableView>
</VBox>
