@startuml CD_03_Client_Detail
!theme plain
skinparam backgroundColor #FAFAFA
skinparam class {
    BackgroundColor #EBF5FB
    BorderColor #2471A3
    FontColor #1A252F
    ArrowColor #1A5276
    HeaderBackgroundColor #2471A3
    HeaderFontColor #FFFFFF
}
skinparam package {
    BackgroundColor #F4F6F7
    BorderColor #85929E
}

title <b>CD-03 – Class Diagram: Package Client – Dettaglio</b>\n<i>GuessTheWord | Corso JA26 – A.A. 2025/2026</i>

package "client.app" {
    class ClientApp <<Application>> {
        - networkService : NetworkService
        + start(stage: Stage) : void
        + main(args: String[]) : void
    }
}

package "client.network" {
    class NetworkService {
        - socket : Socket
        - objectIn : ObjectInputStream
        - objectOut : ObjectOutputStream
        - messageCallbacks : Map<MessageType, Consumer<Message>>
        + connect(ip: String, port: int) : void
        + send(msg: Message) : void
        + onMessage(type: MessageType, cb: Consumer<Message>) : void
        + startListenerThread() : void
        + disconnect() : void
    }
}

package "client.controller" {
    class LoginController {
        - usernameField : TextField
        - passwordField : PasswordField
        + initialize() : void
        + handleLogin(event: ActionEvent) : void
        + handleRegister(event: ActionEvent) : void
        - showError(msg: String) : void
    }

    class WaitingController {
        - statusLabel : Label
        - networkService : NetworkService
        + initialize() : void
        + onChallengeStart(msg: Message) : void
    }

    class GameController {
        - excerptArea : TextArea
        - answerField : TextField
        - timerLabel : Label
        - statusLabel : Label
        - resultPane : Pane
        - countdownTimeline : Timeline
        + initChallenge(data: ChallengeData) : void
        + handleSendAnswer() : void
        + displayResult(msg: Message) : void
        - startCountdown(seconds: int) : void
        - stopCountdown() : void
    }

    class HistoryController {
        - resultsTable : TableView<ResultRow>
        - dateCol : TableColumn<ResultRow, String>
        - outcomeCol : TableColumn<ResultRow, String>
        + initialize() : void
        + loadHistory() : void
    }

    class ResultRow {
        + date : String
        + outcome : String
        + responseTimeMs : long
        + opponentName : String
    }
}

package "client.util" {
    class ConfigLoader {
        + {static} load(filename: String) : Properties
        + {static} getIp(p: Properties) : String
        + {static} getPort(p: Properties) : int
    }

    class SceneManager {
        - {static} primaryStage : Stage
        + {static} switchTo(fxml: String) : void
        + {static} setStage(s: Stage) : void
    }
}

' === RELAZIONI ===
ClientApp --> NetworkService
ClientApp --> ConfigLoader
ClientApp --> SceneManager

LoginController --> NetworkService
LoginController --> SceneManager
WaitingController --> NetworkService
WaitingController --> SceneManager
GameController --> NetworkService
GameController --> SceneManager
HistoryController --> NetworkService

HistoryController ..> ResultRow : usa

LoginController ..> WaitingController : naviga a >
WaitingController ..> GameController : naviga a >
GameController ..> HistoryController : naviga a >

@enduml
