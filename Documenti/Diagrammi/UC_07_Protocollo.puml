@startuml UC_07_Protocollo
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Casi d'Uso - Protocollo di Comunicazione

actor "Client\n(ConnessioneServer)" as Client
actor "Server\n(GestoreClient)" as Server

rectangle "Flusso Messaggi — Classe Messaggio" {

  usecase "Invio LOGIN_REQUEST\n{PayloadAutenticazione:\n nomeUtente, password}" as COM01
  usecase "Ricezione LOGIN_RESPONSE\n{RispostaAutenticazione:\n successo, messaggio, ruolo}" as COM02

  usecase "Invio REGISTER_REQUEST\n{PayloadAutenticazione:\n nomeUtente, password}" as COM03
  usecase "Ricezione REGISTER_RESPONSE\n{RispostaAutenticazione:\n successo, messaggio}" as COM04

  usecase "Ricezione WAITING\n{messaggio di attesa}" as COM05

  usecase "Ricezione CHALLENGE_START\n{PayloadSfida:\n idSfida, estrattoTesto,\n paroleCifrate, secondiTimeout}" as COM06

  usecase "Invio CHALLENGE_ANSWER\n{risposta giocatore}" as COM07

  usecase "Ricezione CHALLENGE_RESULT\n{RisultatoSfida:\n nomeUtenteVincitore,\n parolaCorretta, esito}" as COM08

  usecase "Invio HISTORY_REQUEST" as COM09
  usecase "Ricezione HISTORY_RESPONSE\n{List<VoceStorico>}" as COM10

  usecase "Invio REQUEUE_REQUEST" as COM11
}

Client --> COM01
Client --> COM03
Client --> COM07
Client --> COM09
Client --> COM11

Server --> COM02
Server --> COM04
Server --> COM05
Server --> COM06
Server --> COM08
Server --> COM10

COM01 ..> COM02 : <<include>>\nrisposta server
COM03 ..> COM04 : <<include>>\nrisposta server
COM05 ..> COM06 : <<extend>>\nquando 2° client autentica
COM07 ..> COM08 : <<include>>\nserver valida e risponde
COM09 ..> COM10 : <<include>>\nserver legge DB
COM11 ..> COM05 : <<include>>\nserver mette in lista attesa

note right of COM06
  Contiene l'estratto di testo con
  la parola cifrata tra parentesi quadre,
  la lista di parole cifrate e il timeout.
end note

note right of COM08
  Definisce il risultato finale:
  vittoria, sconfitta o pareggio.
end note

note bottom of COM11
  Richiesta di rimessa in coda per una nuova partita
  sulla connessione TCP già esistente, senza fare relogin.
end note

@enduml
