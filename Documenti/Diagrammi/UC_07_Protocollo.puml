@startuml UC_07_Protocollo
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Diagramma 7 — Casi d'Uso: Protocollo di Comunicazione Client ↔ Server\n(Appendice B — SRS JA26)

actor "Client\n(ConnessioneServer)" as Client
actor "Server\n(GestoreClient)" as Server

rectangle "Flusso Messaggi — Classe Messaggio (enum Tipo)" {

  usecase "COM-01\nInvio LOGIN_REQUEST\n{PayloadAutenticazione:\n nomeUtente, password}" as COM01
  usecase "COM-02\nRicezione LOGIN_RESPONSE\n{RispostaAutenticazione:\n successo, messaggio, ruolo}" as COM02

  usecase "COM-03\nInvio REGISTER_REQUEST\n{PayloadAutenticazione:\n nomeUtente, password}" as COM03
  usecase "COM-04\nRicezione REGISTER_RESPONSE\n{RispostaAutenticazione:\n successo, messaggio}" as COM04

  usecase "COM-05\nRicezione WAITING\n{String: messaggio attesa\n es. 'In attesa (1/2)'}" as COM05

  usecase "COM-06\nRicezione CHALLENGE_START\n{PayloadSfida:\n idSfida, estrattoTesto,\n paroleCifrate, secondiTimeout}" as COM06

  usecase "COM-07\nInvio CHALLENGE_ANSWER\n{String: risposta giocatore}" as COM07

  usecase "COM-08\nRicezione CHALLENGE_RESULT\n{RisultatoSfida:\n nomeUtenteVincitore,\n parolaCorretta, esito}" as COM08

  usecase "COM-09\nInvio HISTORY_REQUEST\n{null}" as COM09
  usecase "COM-10\nRicezione HISTORY_RESPONSE\n{List<VoceStorico>}" as COM10

  usecase "COM-11\nInvio REQUEUE_REQUEST\n{null}" as COM11
}

Client --> COM01
Client --> COM03
Client --> COM07
Client --> COM09
Client --> COM11

Server --> COM02
Server --> COM04
Server --> COM05
Server --> COM06
Server --> COM08
Server --> COM10

COM01 ..> COM02 : <<include>>\nrisposta server
COM03 ..> COM04 : <<include>>\nrisposta server
COM05 ..> COM06 : <<extend>>\nquando 2° client autentica
COM07 ..> COM08 : <<include>>\nserver valida e risponde
COM09 ..> COM10 : <<include>>\nserver legge DB
COM11 ..> COM05 : <<include>>\nserver mette in lista attesa

note right of COM06
  PayloadSfida (Serializable):
  - idSfida (int)
  - estrattoTesto (String)
    con parola cifrata tra [parentesi]
  - paroleCifrate (List<String>)
  - secondiTimeout (int) = 60
end note

note right of COM08
  RisultatoSfida.Esito (enum):
  VITTORIA  → "Hai vinto!" 🏆
  SCONFITTA → "Hai perso." 😞
  PAREGGIO  → "Pareggio!"  🤝
  (Modulo 2 — enum con comportamento)
end note

note bottom of COM11
  REQUEUE_REQUEST inviato dopo
  CHALLENGE_RESULT dalla stessa
  connessione TCP (senza nuovo login).
  CoordinatoreGioco
  .gestisciNuovaRichiesta(client)
end note

@enduml
