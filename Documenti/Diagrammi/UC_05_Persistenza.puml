@startuml UC_05_Persistenza
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Casi d'Uso - Persistenza Dati

actor "Server\n(GestoreDatabase)" as Server
actor "Amministratore" as Admin
actor "Giocatore" as Player
database "DB SQLite\n(database.db)" as DB

rectangle "Strato di Persistenza — IndovinaLaParola" {

  usecase "Gestione tabella users\n(user_id, nomeUtente,\npassword_hash, ruolo, created_at)" as DB_Users

  usecase "Gestione tabella challenges\n(challenge_id, played_at,\ntext_excerpt, encrypted_word,\noriginal_word, caesar_shift)" as DB_Chall

  usecase "Gestione tabella results\n(result_id, challenge_id,\nuser_id, esito, response_time_ms)" as DB_Res

  usecase "Estrazione statistiche" as DB_Stats

  usecase "Creazione account\npredefiniti all'avvio" as DB_Seed

  usecase "Inizializzazione schema\n(CREATE IF NOT EXISTS)" as DB_Init

  usecase "Autenticazione\n(hash SHA-256)" as DB_Auth

  usecase "Registrazione utente" as DB_RegU

  usecase "Salvataggio sfida\nin transazione" as DB_SaveG

  usecase "Storico personale" as DB_Hist
}

Server --> DB_Init
Server --> DB_Users
Server --> DB_Chall
Server --> DB_Res
Server --> DB_Stats
Server --> DB_Seed
Server --> DB_Auth
Server --> DB_RegU
Server --> DB_SaveG
Server --> DB_Hist

Admin  --> DB_Stats : consulta classifiche
Player --> DB_Hist  : visualizza storico

DB_Init   ..> DB_Seed  : <<include>>
DB_Auth   ..> DB_Users : <<include>>
DB_RegU   ..> DB_Users : <<include>>
DB_SaveG  ..> DB_Chall : <<include>>
DB_SaveG  ..> DB_Res   : <<include>>
DB_Stats  ..> DB_Res   : <<include>>
DB_Hist   ..> DB_Res   : <<include>>

DB_Users ..> DB : <<accede>>
DB_Chall ..> DB : <<accede>>
DB_Res   ..> DB : <<accede>>

note right of DB_Seed
  Account creati automaticamente all'avvio se non esistono:
  - admin / admin123
  - giocatore1 / pass1
  - giocatore2 / pass2
end note

note bottom of DB_SaveG
  Usa una transazione JDBC:
  - setAutoCommit(false)
  - inserisce la sfida
  - inserisce i due risultati correlati
  - esegue il commit (o rollback in caso di errore)
end note

note left of DB_Auth
  Le password vengono memorizzate
  esclusivamente come hash SHA-256
  per motivi di sicurezza.
end note

@enduml
