@startuml UC_05_Persistenza
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Diagramma 5 — Casi d'Uso: Persistenza dei Dati (GestoreDatabase)

actor "Server\n(GestoreDatabase)" as Server
actor "Amministratore" as Admin
actor "Giocatore" as Player
database "DB SQLite\n(database.db)" as DB

rectangle "Strato di Persistenza — IndovinaLaParola" {

  usecase "RF-DB-01\nGestione tabella users\n(user_id, nomeUtente,\npassword_hash, ruolo, created_at)" as DB_Users

  usecase "RF-DB-02\nGestione tabella challenges\n(challenge_id, played_at,\ntext_excerpt, encrypted_word,\noriginal_word, caesar_shift)" as DB_Chall

  usecase "RF-DB-03\nGestione tabella results\n(result_id, challenge_id,\nuser_id, esito, response_time_ms)" as DB_Res

  usecase "RF-DB-04\nEstrazione statistiche\n(getAllStats)" as DB_Stats

  usecase "RF-DB-05\nAccount predefiniti\nall'avvio (seedAccounts)\n1 admin + 2 giocatori" as DB_Seed

  usecase "Inizializzazione schema\n(initSchema — CREATE IF NOT EXISTS)" as DB_Init

  usecase "Autenticazione\n(autentica — SHA-256)" as DB_Auth

  usecase "Registrazione utente\n(registraUtente)" as DB_RegU

  usecase "Salvataggio sfida\nin transazione\n(saveChallengeWithResults)" as DB_SaveG

  usecase "Storico personale\n(getHistory)" as DB_Hist
}

Server --> DB_Init
Server --> DB_Users
Server --> DB_Chall
Server --> DB_Res
Server --> DB_Stats
Server --> DB_Seed
Server --> DB_Auth
Server --> DB_RegU
Server --> DB_SaveG
Server --> DB_Hist

Admin  --> DB_Stats : consulta classifiche
Player --> DB_Hist  : visualizza storico

DB_Init   ..> DB_Seed  : <<include>>
DB_Auth   ..> DB_Users : <<include>>
DB_RegU   ..> DB_Users : <<include>>
DB_SaveG  ..> DB_Chall : <<include>>
DB_SaveG  ..> DB_Res   : <<include>>
DB_Stats  ..> DB_Res   : <<include>>
DB_Hist   ..> DB_Res   : <<include>>

DB_Users ..> DB : <<accede>>
DB_Chall ..> DB : <<accede>>
DB_Res   ..> DB : <<accede>>

note right of DB_Seed
  RF-DB-05 [MUST]:
  admin / admin123
  giocatore1 / pass1
  giocatore2 / pass2
  Inseriti con INSERT IF NOT EXISTS
  all'avvio (connetti → seedAccounts).
end note

note bottom of DB_SaveG
  Transazione esplicita JDBC
  (Modulo 8 corso JA26):
  setAutoCommit(false)
  → insertChallenge(...)
  → insertResult(winner, "win")
  → insertResult(loser,  "loss")
  → commit() / rollback()
end note

note left of DB_Auth
  Password salvate come hash SHA-256.
  Nessuna password in chiaro nel DB.
  (RNF-AFF-02 [MUST])
end note

@enduml
