@startuml ER_SchemaDatabase
' Descrizione del diagramma:
' Diagramma Entità-Relazione (ER) del database.
' Aggiornato per riflettere fedelmente la logica e la struttura concettuale
' fornita, includendo tutte le nuove entità, i nuovi attributi e le 
' relazioni (es. OPPONENT) con le cardinalità corrette secondo il pattern.
'
' Pattern applicati:
' 1. Entità: USERS, CHALLENGES, RESULTS con i nuovi attributi strutturali.
' 2. Relazioni e Cardinalità Esplicite (Min, Max): 
'    - GETS: Un utente ottiene (0,N) risultati. Un risultato appartiene a (1,1) utente.
'    - OPPONENT: Un utente fa da avversario in (0,N) risultati. Un risultato ha (0,1) avversario.
'    - PRODUCE: Una sfida produce (0,N) risultati. Un risultato deriva da (1,1) sfida.

skinparam linetype ortho
skinparam classAttributeIconSize 0

title ER — Schema Database (Logica e Struttura Aggiornata)

entity "USERS" as Users {
  * id : INTEGER <<PK>>
  --
  username : TEXT
  password : TEXT
  role : TEXT
  registered_at : DATETIME
}

entity "CHALLENGES" as Challenges {
  * id : INTEGER <<PK>>
  --
  document_name : TEXT
  extract_text : TEXT
  secret_word : TEXT
  cipher_shift : INTEGER
  difficulty : INTEGER
  timeout_seconds : INTEGER
  max_shift : INTEGER
  word_count : INTEGER
  started_at : DATETIME
  ended_at : DATETIME
}

entity "RESULTS" as Results {
  * id : INTEGER <<PK>>
  --
  response : TEXT
  response_ms : INTEGER
  played_at : DATETIME
  winner : TEXT
}

' === RELAZIONI CON CARDINALITÀ ===

' Relazione GETS
Users " (0,N) " -- " (1,1) " Results : "GETS >"

' Relazione OPPONENT (doppia relazione tra USERS e RESULTS)
Users " (0,N) " -- " (0,1) " Results : "OPPONENT >"

' Relazione PRODUCE
Challenges " (0,N) " -- " (1,1) " Results : "PRODUCE >"

' === NOTE (mantenute per logica implementativa) ===

note bottom of Users
  seedAccounts() inserisce i profili base.
  Le password sono salvate come hash.
end note

note bottom of Results
  La doppia relazione (GETS e OPPONENT)
  permette concettualmente di individuare 
  subito chi ha giocato e contro chi,
  senza complesse subquery a livello logico.
end note

@enduml
