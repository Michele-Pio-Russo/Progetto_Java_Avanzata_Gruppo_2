@startuml UC_06_ConfigurazioneAvvio
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor MistyRose
  BorderColor Crimson
}

title UC_06 — Configurazione e Avvio del Sistema

actor "Amministratore" as A
actor "Giocatore" as G
actor "Sistema" as S

rectangle "Modulo Configurazione e Avvio" {
  usecase "Avviare server.jar\n(java -jar)" as UC_SRV_START
  usecase "Avviare client.jar\n(java -jar)" as UC_CLI_START

  usecase "Leggere server.properties\n(CaricatoreConfigurazione)" as UC_SRV_PROP
  usecase "Leggere client.properties\n(ConfigurazioneClient)" as UC_CLI_PROP
  usecase "Usare valori di default\nse file assente" as UC_DEFAULT
  usecase "Inizializzare schema DB\n(initSchema + seed)" as UC_INIT_DB
  usecase "Aprire ServerSocket\nsu porta configurata" as UC_OPEN_SOCKET
  usecase "Connettere Socket TCP\na server.ip:server.port" as UC_CONNECT
  usecase "Inizializzare OOS\nprima di OIS + flush()" as UC_STREAMS
}

A -- UC_SRV_START
G -- UC_CLI_START
S -- UC_INIT_DB

UC_SRV_START ..> UC_SRV_PROP : <<include>>
UC_CLI_START ..> UC_CLI_PROP : <<include>>

UC_SRV_PROP ..> UC_DEFAULT : <<extend>>\n(file non trovato)
UC_CLI_PROP ..> UC_DEFAULT : <<extend>>\n(file non trovato)

UC_SRV_START ..> UC_INIT_DB     : <<include>>
UC_SRV_START ..> UC_OPEN_SOCKET : <<include>>
UC_CLI_START ..> UC_CONNECT     : <<include>>

UC_OPEN_SOCKET ..> UC_STREAMS : <<include>>
UC_CONNECT     ..> UC_STREAMS : <<include>>

note right of UC_SRV_PROP
  Chiavi: server.port (default 5000),
  db.path (default db/database.db),
  analysis.save.path
  (default data/analysis.dat),
  game.timeout.seconds (default 60),
  game.excerpt.words (default 60).
  Se il file manca, il server prosegue
  con i default loggando un avviso
  (non termina con eccezione).
end note

note right of UC_CLI_PROP
  Chiavi: server.ip (default 127.0.0.1),
  server.port (default 5000).
  Fallback automatico sui default
  se client.properties e' assente.
end note

note bottom of UC_STREAMS
  Regola fondamentale (entrambi i lati):
  ObjectOutputStream creato PRIMA di
  ObjectInputStream, con out.flush()
  immediato dopo la costruzione di OOS,
  per evitare il deadlock nel costruttore
  di OIS.
end note
@enduml
