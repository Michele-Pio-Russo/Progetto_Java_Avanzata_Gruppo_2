@startuml SEQ_04_SfidaCompleta
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_04 — Sfida Completa (UC-G04): cifratura Cesare, risposte parallele, vincitore, DB

actor "Giocatore 1" as G1
actor "Giocatore 2" as G2
participant "ControllerGioco\n(Client 1/2)" as CG
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD
participant "AnalizzatoreDocumenti" as AN
participant "CifrarioCesare" as CES
participant "GestoreDatabase" as DB_MGR
database "SQLite" as DB

== Avvio sfida (giocatoriInAttesa == 2) ==
COORD -> COORD : avviaSfida(p1, p2)
COORD -> AN : extractRandomExcerpt(excerptWords)
AN --> COORD : estratto (~60 parole)
COORD -> AN : selectWordFromExcerpt(estratto, difficulty)
AN -> AN : filtra parole >= 4 caratteri,\nComparator lambda su TF,\ntop-5, scelta casuale
AN --> COORD : parolaOriginale
COORD -> COORD : shift = random(1,25)
COORD -> CES : cifra(parolaOriginale, shift)
CES --> COORD : parolaCifrata
COORD -> COORD : sostituisce nel testo\n[parolaCifrata] (Pattern.quote())
COORD -> COORD : crea PayloadSfida(idSfida,\nestratto, [parolaCifrata], timeoutSeconds)
COORD -> COORD : scheduler.schedule(taskTimeout,\ntimeoutSeconds, SECONDS)
COORD -> GC : invia(CHALLENGE_START, payload) x2
GC --> CG : CHALLENGE_START

CG --> G1 : Mostra gamePane + avvia Timeline
CG --> G2 : Mostra gamePane + avvia Timeline

== Risposta Giocatore 1 (corretta) ==
G1 -> CG : digita parola, Invio/Invia
CG -> GC : invia(CHALLENGE_ANSWER, "parola")
GC -> COORD : gestisciRisposta(client1, "parola", t1)
COORD -> COORD : confronto case-insensitive\ncon parolaOriginaleCorrente

alt risposta corretta
  COORD -> COORD : taskTimeout.cancel()
  COORD -> COORD : terminaSfida(client1, t1, false)
  COORD -> COORD : Esito: VITTORIA (G1) /\nSCONFITTA (G2)
  COORD -> DB_MGR : saveChallengeWithResults(\nchallenge, risultati[2])
  DB_MGR -> DB : setAutoCommit(false)
  DB_MGR -> DB : INSERT INTO challenges (...)
  DB_MGR -> DB : INSERT INTO results (G1, 'win', t1)
  DB_MGR -> DB : INSERT INTO results (G2, 'loss', -1)
  DB_MGR -> DB : commit()
  DB --> DB_MGR : ok
  COORD -> GC : invia(CHALLENGE_RESULT,\nRisultatoSfida) x2
  GC --> CG : CHALLENGE_RESULT
  CG -> CG : ferma Timeline
  CG --> G1 : pannelloRisultato\n(VITTORIA, emoji, parola corretta)
  CG --> G2 : pannelloRisultato\n(SCONFITTA, emoji, parola corretta)

else risposta errata
  COORD -> GC : invia(ERROR,\n"Risposta errata. Riprova!")\n(solo a client1)
  GC --> CG : ERROR
  CG --> G1 : etichettaFeedback aggiornata,\ncampo risposta riabilitato
  note over COORD
    Sfida continua,
    timeout non resettato
  end note
end
@enduml
