@startuml ER_Database
skinparam classAttributeIconSize 0
skinparam entity {
  BackgroundColor #F4ECF7
  BorderColor #7D3C98
  HeaderBackgroundColor #7D3C98
  HeaderFontColor White
}
skinparam arrow {
  Color #2C3E50
}

title Diagramma E-R — Schema Database SQLite\nIndovinaLaParola | Corso JA26 — A.A. 2025/2026

entity "users" as USR {
  * user_id       : INTEGER  <<PK, AUTOINCREMENT>>
  --
  * nomeUtente    : TEXT     <<UNIQUE, NOT NULL>>
  * password_hash : TEXT     <<NOT NULL>> (SHA-256)
  * ruolo         : TEXT     <<'admin' | 'player'>>
    created_at    : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
}

entity "challenges" as CHG {
  * challenge_id  : INTEGER  <<PK, AUTOINCREMENT>>
  --
    played_at     : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
    text_excerpt  : TEXT
    encrypted_word: TEXT
    original_word : TEXT
    caesar_shift  : INTEGER
}

entity "results" as RES {
  * result_id        : INTEGER <<PK, AUTOINCREMENT>>
  --
  * challenge_id     : INTEGER <<FK → challenges.challenge_id>>
  * user_id          : INTEGER <<FK → users.user_id>>
  * esito            : TEXT    <<'win' | 'loss' | 'draw'>>
    response_time_ms : INTEGER  (−1 se timeout/draw)
}

' === RELAZIONI ===
USR ||--o{ RES : "partecipa a\n(come vincitore\no perdente)"
CHG ||--|{ RES : "genera\n(2 righe per sfida)"
CHG }o--|| USR : "riferimento ai\npartecipanti\n(via results)"

note bottom of USR
  RF-DB-01 [MUST] e RF-DB-05 [MUST]:
  Account predefiniti (seedAccounts):
  • admin / admin123 (ruolo: admin)
  • giocatore1 / pass1 (ruolo: player)
  • giocatore2 / pass2 (ruolo: player)
  Le password sono hashate SHA-256
  prima di essere salvate nel DB.
end note

note bottom of CHG
  RF-DB-02 [MUST]:
  La parola cifrata appare nell'estratto
  tra [parentesi quadre].
  caesar_shift conservato per debug
  e verifica dell'algoritmo.
end note

note bottom of RES
  RF-DB-03 [MUST]:
  Per ogni sfida vengono inserite
  sempre 2 righe in transazione
  atomica JDBC (Modulo 8):
  - vincitore: esito='win',
    response_time_ms=tempoEffettivo
  - perdente:  esito='loss',
    response_time_ms=-1
  - pareggio:  esito='draw'
    response_time_ms=-1 per entrambi

  RF-DB-04 [MUST] — Query statistiche:
  ─────────────────────────────────
  Vittorie: COUNT WHERE esito='win'
  Partite:  COUNT(*)
  Tempo medio: AVG(ms) WHERE ms >= 0
  (Vedi GestoreDatabase.getAllStats()
   e GestoreDatabase.getHistory())
end note

@enduml
