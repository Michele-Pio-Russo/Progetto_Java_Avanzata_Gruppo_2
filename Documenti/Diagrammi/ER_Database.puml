@startuml ER_Database
skinparam classAttributeIconSize 0
skinparam entity {
  BackgroundColor #F4ECF7
  BorderColor #7D3C98
  HeaderBackgroundColor #7D3C98
  HeaderFontColor White
}
skinparam arrow {
  Color #2C3E50
}

title Schema Database SQLite (Diagramma E-R)

entity "users" as USR {
  * user_id       : INTEGER  <<PK, AUTOINCREMENT>>
  --
  * nomeUtente    : TEXT     <<UNIQUE, NOT NULL>>
  * password_hash : TEXT     <<NOT NULL>> (SHA-256)
  * ruolo         : TEXT     <<'admin' | 'player'>>
  * created_at    : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
}

entity "challenges" as CHG {
  * challenge_id  : INTEGER  <<PK, AUTOINCREMENT>>
  --
  * played_at     : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
  * text_excerpt  : TEXT
  * encrypted_word: TEXT
  * original_word : TEXT
  * caesar_shift  : INTEGER
}

entity "results" as RES {
  * result_id        : INTEGER <<PK, AUTOINCREMENT>>
  --
  * challenge_id     : INTEGER <<FK → challenges.challenge_id>>
  * user_id          : INTEGER <<FK → users.user_id>>
  * esito            : TEXT    <<'win' | 'loss' | 'draw'>>
  * response_time_ms : INTEGER  (−1 se timeout/draw)
}

' --- Relazioni ---
USR ||--o{ RES : "partecipa a\n(come vincitore\no perdente)"
CHG ||--|{ RES : "genera\n(2 righe per sfida)"
CHG }o--|| USR : "riferimento ai\npartecipanti\n(via results)"

note bottom of USR
  Salva gli utenti registrati.
  Le password sono salvate cifrate con SHA-256.
  All'avvio del server vengono inseriti gli account di test:
  - admin (password: admin123)
  - giocatore1 (password: pass1)
  - giocatore2 (password: pass2)
end note

note bottom of CHG
  Salva i dati di ogni partita (l'estratto di testo, la parola cifrata, la parola originale e lo spostamento usato per il cifrario).
end note

note bottom of RES
  Per ogni sfida vengono inserite due righe (una per giocatore) in una singola transazione.
  L'esito può essere 'win', 'loss' o 'draw'.
  Il tempo di risposta è in millisecondi (impostato a -1 in caso di sconfitta o pareggio).

  Statistiche estratte:
  - Numero di vittorie (COUNT con esito='win')
  - Partite totali (COUNT(*))
  - Tempo medio di risposta (AVG del tempo di risposta dove >= 0)
end note

@enduml
