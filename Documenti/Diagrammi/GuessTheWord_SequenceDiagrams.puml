' ================================================================
'  INDOVINA LA PAROLA (GuessTheWord) — FILE 2
'  SEQUENCE DIAGRAMS (6 diagrammi)
' ================================================================


' ============================================================
' SEQ_01 — Registrazione (UC-G01)
' ============================================================
@startuml SEQ_01_Registrazione
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_01 — Registrazione (UC-G01)

actor "Giocatore" as G
participant "ControllerAccesso" as CA
participant "ConnessioneServer" as CONN
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD
participant "GestoreDatabase" as DB_MGR
database "SQLite\n(users)" as DB

G -> CA : Inserisce username,\npassword, conferma password
CA -> CA : Valida campi:\nusername >= 3 caratteri,\npassword >= 4 caratteri,\nconferma == password

alt Validazione client OK
  CA -> CONN : invia(REGISTER_REQUEST,\nPayloadAutenticazione(user, pwd))
  CONN -> GC : invio su Socket TCP (OOS)
  GC -> COORD : gestisciRegistrazione(payload)
  COORD -> DB_MGR : registraUtente(nomeUtente, password)
  DB_MGR -> DB_MGR : hashPassword() -> SHA-256
  DB_MGR -> DB : SELECT user WHERE nomeUtente = ?

  alt Username non esistente
    DB --> DB_MGR : nessun risultato
    DB_MGR -> DB : INSERT INTO users\n(nomeUtente, password_hash, ruolo='player')
    DB --> DB_MGR : ok
    DB_MGR --> COORD : successo = true
    COORD -> GC : invia(REGISTER_RESPONSE,\nRispostaAutenticazione(true, "Registrazione ok", null))
  else Username gia' esistente
    DB --> DB_MGR : utente trovato
    DB_MGR --> COORD : successo = false
    COORD -> GC : invia(REGISTER_RESPONSE,\nRispostaAutenticazione(false, "Username gia' esistente", null))
  end

  GC --> CONN : REGISTER_RESPONSE (OIS)
  CONN --> CA : callbackMessaggio(messaggio)
  CA --> G : Mostra esito registrazione

else Validazione client fallita
  CA --> G : Mostra errore di validazione\n(campo vuoto / lunghezza minima\n/ conferma non corrispondente)
end
@enduml


' ============================================================
' SEQ_02 — Login (UC-G02, UC-A01)
' ============================================================
@startuml SEQ_02_Login
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_02 — Login (UC-G02 / UC-A01) con biforcazione admin/giocatore

actor "Utente\n(Admin o Giocatore)" as U
participant "ControllerAccesso" as CA
participant "ConnessioneServer" as CONN
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD
participant "GestoreDatabase" as DB_MGR
database "SQLite\n(users)" as DB

U -> CA : Inserisce username e password,\npreme "Accedi"
CA -> CONN : invia(LOGIN_REQUEST,\nPayloadAutenticazione(user, pwd))
CONN -> GC : invio su Socket TCP (OOS, thread separato)
GC -> COORD : gestisciLogin(payload)
COORD -> DB_MGR : autentica(nomeUtente, password) : String
DB_MGR -> DB_MGR : hashPassword(password) -> SHA-256
DB_MGR -> DB : SELECT password_hash, ruolo\nFROM users WHERE nomeUtente = ?\nAND password_hash = ?
DB --> DB_MGR : ruolo (o nessuna riga)

alt Credenziali valide
  DB_MGR --> COORD : ruolo = "admin" | "player"
  COORD -> GC : setNomeUtente(), setRuolo(),\nsetAutenticato(true)

  alt ruolo == "player"
    COORD -> COORD : giocatoriInAttesa.add(client)\n(controllo duplicati IF-S23)
    COORD -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(true, msg, "player"))
    GC --> CONN : LOGIN_RESPONSE
    CONN --> CA : callbackMessaggio
    CA --> U : Carica game.fxml,\nmostra waitingPane
    COORD -> GC : invia(WAITING, "1/2")
    GC --> CONN : WAITING
    CONN --> CA : ControllerGioco.consegnaMessaggio()
    CA --> U : Aggiorna stato attesa

  else ruolo == "admin"
    COORD -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(true, msg, "admin"))
    GC --> CONN : LOGIN_RESPONSE
    CONN --> CA : callbackMessaggio
    CA --> U : Apre GUI Amministratore\n(ControllerServer)
  end

else Credenziali non valide
  DB_MGR --> COORD : ruolo = null
  COORD -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(false,\n"Credenziali errate", null))
  GC --> CONN : LOGIN_RESPONSE
  CONN --> CA : callbackMessaggio
  CA --> U : Mostra messaggio di errore\nnella schermata di accesso
end
@enduml


' ============================================================
' SEQ_03 — Analisi Documenti (UC-A02..UC-A04)
' ============================================================
@startuml SEQ_03_AnalisiDocumenti
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_03 — Analisi Documenti (UC-A02÷UC-A04): Task asincrono + Stream API + serializzazione

actor "Amministratore" as A
participant "ControllerServer" as CS
participant "ServizioAnalisi\n(javafx.concurrent.Service)" as SVC
participant "Task interno" as TASK
participant "AnalizzatoreDocumenti" as AN
participant "FileSystem" as FS

A -> CS : Seleziona file .txt (FileChooser)
CS -> CS : Aggiunge nomi alla ListView
A -> CS : Clicca "Avvia Analisi"

CS -> SVC : reset() + start()
SVC -> TASK : crea e avvia Task in background\n(FX Application Thread libero)

CS -> SVC : bind ProgressBar a\nanalysisService.progressProperty()
CS -> SVC : listener su\nanalysisService.messageProperty()\n(Platform.runLater)

TASK -> FS : legge tutti i file selezionati
FS --> TASK : contenuto testuale concatenato
TASK -> TASK : tokenizza in lowercase\n(regex [^a-zA-Z\\s])

TASK -> TASK : Stream: Arrays.stream(tokens)\n.filter(...)\n.collect(Collectors.groupingBy(\n  Function.identity(), counting()))
TASK -> TASK : entrySet.stream()\n.collect(Collectors.toMap(\n  k -> k, v -> count/totalWords))
TASK -> SVC : updateProgress() / updateMessage()
SVC --> CS : Platform.runLater:\naggiorna ProgressBar e Label

TASK -> AN : popola mappa TF\n(Collections.unmodifiableMap)
TASK --> SVC : succeeded() -> AnalizzatoreDocumenti
SVC --> CS : risultato disponibile

CS -> CS : populateTfTable()\n(Stream: sorted -> limit(500) -> forEach)
CS --> A : Mostra TableView TF\n(top-500 per frequenza decrescente)

== UC-A04: Salvataggio analisi ==
A -> CS : Clicca "Salva Analisi"
CS -> AN : saveToFile(path)\n(default data/analysis.dat)
AN -> FS : ObjectOutputStream.writeObject(this)
FS --> AN : ok
AN --> CS : salvataggio completato
CS --> A : Conferma salvataggio

== UC-A05: Caricamento analisi ==
A -> CS : Clicca "Carica Analisi"
CS -> AN : loadFromFile(path)
AN -> FS : ObjectInputStream.readObject()
FS --> AN : AnalizzatoreDocumenti deserializzato
AN -> AN : setAnalyzer() nel CoordinatoreGioco
AN --> CS : analisi caricata senza rielaborazione
CS --> A : Mostra TableView TF aggiornata
@enduml


' ============================================================
' SEQ_04 — Sfida Completa (UC-G04), flusso end-to-end
' ============================================================
@startuml SEQ_04_SfidaCompleta
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_04 — Sfida Completa (UC-G04): cifratura Cesare, risposte parallele, vincitore, DB

actor "Giocatore 1" as G1
actor "Giocatore 2" as G2
participant "ControllerGioco\n(Client 1/2)" as CG
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD
participant "AnalizzatoreDocumenti" as AN
participant "CifrarioCesare" as CES
participant "GestoreDatabase" as DB_MGR
database "SQLite" as DB

== Avvio sfida (giocatoriInAttesa == 2) ==
COORD -> COORD : avviaSfida(p1, p2)
COORD -> AN : extractRandomExcerpt(excerptWords)
AN --> COORD : estratto (~60 parole)
COORD -> AN : selectWordFromExcerpt(estratto, difficulty)
AN -> AN : filtra parole >= 4 caratteri,\nComparator lambda su TF,\ntop-5, scelta casuale
AN --> COORD : parolaOriginale
COORD -> COORD : shift = random(1,25)
COORD -> CES : cifra(parolaOriginale, shift)
CES --> COORD : parolaCifrata
COORD -> COORD : sostituisce nel testo\n[parolaCifrata] (Pattern.quote())
COORD -> COORD : crea PayloadSfida(idSfida,\nestratto, [parolaCifrata], timeoutSeconds)
COORD -> COORD : scheduler.schedule(taskTimeout,\ntimeoutSeconds, SECONDS)
COORD -> GC : invia(CHALLENGE_START, payload) x2
GC --> CG : CHALLENGE_START

CG --> G1 : Mostra gamePane + avvia Timeline
CG --> G2 : Mostra gamePane + avvia Timeline

== Risposta Giocatore 1 (corretta) ==
G1 -> CG : digita parola, Invio/Invia
CG -> GC : invia(CHALLENGE_ANSWER, "parola")
GC -> COORD : gestisciRisposta(client1, "parola")
COORD -> COORD : t1 = currentTimeMillis() - tempoInizioSfida
COORD -> COORD : confronto case-insensitive\ncon parolaOriginaleCorrente

alt risposta corretta
  COORD -> COORD : taskTimeout.cancel()
  COORD -> COORD : terminaSfida(client1, t1, false)
  COORD -> COORD : Esito: VITTORIA (G1) /\nSCONFITTA (G2)
  COORD -> DB_MGR : saveChallengeWithResults(\nchallenge, risultati[2])
  DB_MGR -> DB : setAutoCommit(false)
  DB_MGR -> DB : INSERT INTO challenges (...)
  DB_MGR -> DB : INSERT INTO results (G1, 'win', t1)
  DB_MGR -> DB : INSERT INTO results (G2, 'loss', -1)
  DB_MGR -> DB : commit()
  DB --> DB_MGR : ok
  COORD -> GC : invia(CHALLENGE_RESULT,\nRisultatoSfida) x2
  GC --> CG : CHALLENGE_RESULT
  CG -> CG : ferma Timeline
  CG --> G1 : pannelloRisultato\n(VITTORIA, emoji, parola corretta)
  CG --> G2 : pannelloRisultato\n(SCONFITTA, emoji, parola corretta)

else risposta errata
  COORD -> GC : invia(ERROR,\n"Risposta errata. Riprova!")\n(solo a client1)
  GC --> CG : ERROR
  CG --> G1 : etichettaFeedback aggiornata,\ncampo risposta riabilitato
  note over COORD
    Sfida continua,
    timeout non resettato
  end note
end
@enduml


' ============================================================
' SEQ_05 — Avvio Server (Bootstrap)
' ============================================================
@startuml SEQ_05_AvvioServer
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_05 — Avvio Server: properties, schema SQLite, ServerSocket, UI admin

actor "Amministratore" as A
participant "ApplicazioneServer\n(main)" as APP
participant "CaricatoreConfigurazione" as CFG
participant "GestoreDatabase\n(Singleton)" as DB_MGR
participant "ReteServer" as RETE
participant "CoordinatoreGioco" as COORD
participant "ControllerServer\n(GUI)" as CS
database "SQLite\n(database.db)" as DB

A -> APP : esegue "java -jar server.jar"
APP -> CFG : carica server.properties

alt file presente
  CFG --> APP : server.port, db.path,\nanalysis.save.path,\ngame.timeout.seconds,\ngame.excerpt.words
else file assente
  CFG -> CFG : log warning
  CFG --> APP : valori di default
end

APP -> DB_MGR : getInstance(db.path)
DB_MGR -> DB : connetti()
DB_MGR -> DB : initSchema()\n(CREATE TABLE IF NOT EXISTS\nusers, challenges, results)
DB_MGR -> DB : seedAccounts()\n(insertUserIfAbsent per\nadmin/giocatore1/giocatore2)
DB --> DB_MGR : schema pronto

APP -> COORD : crea CoordinatoreGioco(db, config)
APP -> RETE : crea ReteServer(port, coordinatore)
APP -> CS : avvia GUI JavaFX\n(ControllerServer, server.fxml)
CS --> A : Mostra finestra admin\n(pulsanti Avvia/Stop, Seleziona file,\nAvvia Analisi, ecc.)

A -> CS : Clicca "Avvia Server"
CS -> RETE : avvia()
RETE -> RETE : new ServerSocket(port)
RETE -> RETE : avvia ServerAcceptThread\n(thread daemon)
RETE --> CS : log "Server avviato sulla porta 5000"
CS --> A : Mostra log nella GUI

loop per ogni connessione client
  RETE -> RETE : accept()
  RETE -> RETE : crea GestoreClient dedicato
  RETE -> RETE : gestoreClient.startListening()\n(thread daemon, OOS prima di OIS + flush())
end
@enduml


' ============================================================
' SEQ_06 — Classifiche e Storico (UC-A06, UC-G06... -> UC-A07/UC-G07)
' ============================================================
@startuml SEQ_06_ClassificheStorico
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_06 — Classifiche (UC-A07) e Storico (UC-G07): query SQL vittorie, partite, tempo medio

actor "Amministratore" as A
actor "Giocatore" as G
participant "ControllerServer" as CS
participant "ControllerStorico" as CST
participant "ConnessioneServer" as CONN
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD
participant "GestoreDatabase" as DB_MGR
database "SQLite\n(results, users, challenges)" as DB

== UC-A07: Visualizzazione classifica (lato Admin, locale al server) ==
A -> CS : Clicca "Aggiorna Classifica"
CS -> DB_MGR : getAllStats()
DB_MGR -> DB : SELECT u.nomeUtente,\n SUM(CASE esito='win' THEN 1 ELSE 0) AS wins,\n COUNT(*) AS games_played,\n CAST(AVG(CASE response_time_ms>=0\n  THEN response_time_ms END) AS INTEGER) AS avg_ms\nFROM results r JOIN users u ON r.user_id=u.user_id\nGROUP BY r.user_id ORDER BY wins DESC
DB --> DB_MGR : righe (nomeUtente, wins,\ngames_played, avg_ms)
DB_MGR --> CS : List<StatisticaGiocatore>
CS -> CS : popola TableView classifica\n(username, vittorie, partite, tempo medio)
CS --> A : Mostra classifica aggiornata

== UC-G07: Storico partite (lato Giocatore, via rete) ==
G -> CST : Clicca "Storico"
CST -> CONN : invia(HISTORY_REQUEST, null)
CONN -> GC : invio su Socket TCP
GC -> COORD : gestisciRichiestaStorico(nomeUtente)
COORD -> DB_MGR : getHistory(nomeUtente)
DB_MGR -> DB : SELECT c.played_at, c.original_word,\n r.esito, r.response_time_ms,\n (SELECT u2.nomeUtente FROM results r2\n  JOIN users u2 ON r2.user_id=u2.user_id\n  WHERE r2.challenge_id=c.challenge_id\n    AND u2.nomeUtente != ?) AS avversario\nFROM results r JOIN challenges c\n ON r.challenge_id=c.challenge_id\nJOIN users u ON r.user_id=u.user_id\nWHERE u.nomeUtente = ?\nORDER BY c.played_at DESC
DB --> DB_MGR : righe storico
DB_MGR --> COORD : List<VoceStorico>
COORD -> GC : invia(HISTORY_RESPONSE, List<VoceStorico>)
GC --> CONN : HISTORY_RESPONSE
CONN --> CST : callbackMessaggio

CST -> CST : popola TableView\n(data, avversario, esito, parola, tempo)
CST -> CST : CellFactory colora righe:\nverde=Vinto, rosso=Perso, giallo=Pareggio;\n"—" se response_time_ms < 0
CST --> G : Mostra storico partite

== UC-G08: Ritorno da storico ==
G -> CST : Clicca "Indietro"
CST -> CST : ricarica game.fxml, gc.init()
CST -> CONN : invia(REQUEUE_REQUEST, null)
CONN -> GC : invio su Socket TCP
GC -> COORD : gestisciNuovaRichiesta(client)
COORD -> COORD : reinserisce in\ngiocatoriInAttesa (se non presente)
COORD -> GC : invia(WAITING, "1/2")
GC --> CONN : WAITING
CONN --> CST : ControllerGioco.consegnaMessaggio()
CST --> G : Mostra waitingPane
@enduml


@startuml SEQ_07_AttesaEAvvioSfida
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_07 — Attesa Partita e Avvio Automatico Sfida (UC-G03)

actor "Giocatore 1" as G1
actor "Giocatore 2" as G2
participant "GestoreClient 1" as GC1
participant "GestoreClient 2" as GC2
participant "CoordinatoreGioco" as COORD

== Giocatore 1 si autentica ==
G1 -> GC1 : login effettuato (ruolo=player)
GC1 -> COORD : aggiungiInListaAttesa(client1)

alt client1 già presente in giocatoriInAttesa
  COORD -> GC1 : invia(ERROR,\n"Sei già in lista d'attesa")
  GC1 --> G1 : Mostra messaggio di errore
else client1 non presente
  COORD -> COORD : giocatoriInAttesa.add(client1)\n(size = 1)
  COORD -> GC1 : invia(WAITING, "1/2")
  GC1 --> G1 : Mostra waitingPane\n("In attesa di un avversario... 1/2")
end

== Giocatore 2 si autentica ==
G2 -> GC2 : login effettuato (ruolo=player)
GC2 -> COORD : aggiungiInListaAttesa(client2)
COORD -> COORD : giocatoriInAttesa.add(client2)\n(size = 2)
COORD -> GC2 : invia(WAITING, "2/2")
GC2 --> G2 : Mostra waitingPane\n("In attesa di un avversario... 2/2")

== Soglia raggiunta: avvio automatico sfida ==
COORD -> COORD : giocatoriInAttesa.size() == 2\n-> rimuove p1, p2 dalla lista
COORD -> COORD : avviaSfida(p1, p2)\n(vedi SEQ_04 — Sfida Completa)

note over COORD
  IF-S23: l'accesso duplicato in lista
  d'attesa è bloccato (controllo per
  nomeUtente già presente).
  IF-S24: al raggiungimento di 2
  elementi, il server rimuove i due
  giocatori e chiama avviaSfida(p1, p2),
  che genera estratto, parola, shift
  e invia CHALLENGE_START (SEQ_04).
end note
@enduml


@startuml SEQ_08_SfidaFlussiAlternativi
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_08 — UC-G04: Flussi Alternativi A (Timeout) e C (Disconnessione)

actor "Giocatore 1" as G1
actor "Giocatore 2" as G2
participant "ControllerGioco\n(Client 1/2)" as CG
participant "GestoreClient 1" as GC1
participant "GestoreClient 2" as GC2
participant "CoordinatoreGioco" as COORD
participant "GestoreDatabase" as DB_MGR
database "SQLite" as DB

== Stato iniziale: sfida avviata (vedi SEQ_04) ==
COORD -> COORD : scheduler.schedule(taskTimeout,\ntimeoutSeconds, SECONDS)
COORD -> COORD : sfidaAttiva = true

== Alt. A — Timeout (nessuna risposta corretta) ==
... timeoutSeconds secondi trascorsi senza risposta corretta ...
COORD -> COORD : taskTimeout.run()\n(Runnable synchronized su\nCoordinatoreGioco.this)
COORD -> COORD : controlla sfidaAttiva == true

alt sfidaAttiva == true
  COORD -> COORD : terminaSfida(null, -1, true)
  COORD -> COORD : Esito.PAREGGIO per entrambi
  COORD -> DB_MGR : saveChallengeWithResults(\nchallenge, results[2])
  DB_MGR -> DB : setAutoCommit(false)
  DB_MGR -> DB : INSERT INTO challenges (...)
  DB_MGR -> DB : INSERT INTO results\n(user1, 'draw', -1)
  DB_MGR -> DB : INSERT INTO results\n(user2, 'draw', -1)
  DB_MGR -> DB : commit()
  DB --> DB_MGR : ok
  COORD -> COORD : taskTimeout già consumato\n(annullamento non necessario)
  COORD -> GC1 : invia(CHALLENGE_RESULT,\nRisultatoSfida(null, parolaCorretta, PAREGGIO))
  COORD -> GC2 : invia(CHALLENGE_RESULT,\nRisultatoSfida(null, parolaCorretta, PAREGGIO))
  GC1 --> CG : CHALLENGE_RESULT (PAREGGIO)
  GC2 --> CG : CHALLENGE_RESULT (PAREGGIO)
  CG -> CG : ferma countdownTimeline
  CG --> G1 : pannelloRisultato\n(🤝 "Pareggio!", parola corretta)
  CG --> G2 : pannelloRisultato\n(🤝 "Pareggio!", parola corretta)
else sfidaAttiva == false (risposta già arrivata)
  COORD -> COORD : nessuna azione\n(la sfida è già terminata)
end

== Alt. C — Disconnessione di un avversario durante la sfida ==
GC1 -> GC1 : cicloAscolto() riceve\nEOFException / SocketException
GC1 -> COORD : onClientDisconnesso(client1)
COORD -> COORD : controlla se client1 è in\nuna sfida attiva (giocatore1/giocatore2)

alt sfida attiva con client1 coinvolto
  COORD -> COORD : taskTimeout.cancel()
  COORD -> COORD : sfidaAttiva = false
  COORD -> GC2 : invia(ERROR,\n"L'avversario si è disconnesso.\nLa partita è annullata.")
  GC2 --> CG : ERROR (avversario disconnesso)
  CG -> CG : ferma countdownTimeline
  CG --> G2 : Mostra messaggio di errore\nin etichettaFeedback
  note over COORD
    Nessun salvataggio su DB:
    la sfida annullata per
    disconnessione NON viene
    persistita (Alt. C esclusa
    da saveChallengeWithResults).
  end note
  ... Timeline one-shot 3 secondi (lato client G2) ...
  CG -> GC2 : invia(REQUEUE_REQUEST)
  GC2 -> COORD : gestisciNuovaRichiesta(client2)
  COORD -> COORD : reinserisce client2 in\ngiocatoriInAttesa
  COORD -> GC2 : invia(WAITING, "1/2")
  GC2 --> CG : WAITING
  CG --> G2 : Mostra waitingPane
else client1 non era in sfida attiva
  COORD -> COORD : rimuove client1 da\ngiocatoriInAttesa (se presente)
end
@enduml


@startuml SEQ_09_NuovaPartita
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_09 — Nuova Partita (UC-G06): richiesta di rientro in coda dopo l'esito

actor "Giocatore" as G
participant "ControllerGioco" as CG
participant "ConnessioneServer" as CONN
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD

== Stato iniziale: pannelloRisultato visibile (post CHALLENGE_RESULT) ==
CG --> G : Mostra pannelloRisultato\n(emoji, esito, parola corretta,\npulsante "Nuova partita")

G -> CG : Clicca "Nuova partita"
CG -> CG : nasconde pannelloRisultato,\nmostra waitingPane\n(setVisible/setManaged, StackPane)

CG -> CONN : invia(REQUEUE_REQUEST, null)
CONN -> GC : invio su Socket TCP (OOS, invia() synchronized + reset())
GC -> COORD : gestisciNuovaRichiesta(client)

COORD -> COORD : verifica che il client sia\nautenticato e non già presente\nin giocatoriInAttesa

alt client non presente in coda
  COORD -> COORD : giocatoriInAttesa.add(client)
  COORD -> GC : invia(WAITING, "N/2")
else client già in coda
  COORD -> GC : invia(ERROR,\n"Sei già in lista d'attesa")
end

GC --> CONN : WAITING / ERROR
CONN --> CG : callbackMessaggio(messaggio)
CG --> G : Aggiorna waitingPane\ncon stato attesa

note over COORD
  IF-S29: gestisciNuovaRichiesta()
  (REQUEUE_REQUEST) reinserisce un
  giocatore già autenticato in lista
  d'attesa senza richiedere nuove
  credenziali, sulla stessa connessione
  TCP già stabilita al login (UC-G02).
end note

== Quando in coda si raggiungono 2 giocatori ==
... vedi SEQ_07 — Attesa e Avvio Sfida ...
COORD -> COORD : avviaSfida(p1, p2)\n(vedi SEQ_04 — Sfida Completa)
@enduml


@startuml SEQ_10_StopServer
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_10 — Stop Server (UC-A06, parte "Stop")

actor "Amministratore" as A
participant "ControllerServer" as CS
participant "ReteServer" as RETE
participant "GestoreClient i" as GC
participant "CoordinatoreGioco" as COORD
participant "ServerAcceptThread" as ACCEPT

== Stato iniziale: server in esecuzione ==
note over RETE
  ServerSocket aperto sulla porta
  configurata; ServerAcceptThread
  (daemon) in attesa su accept();
  N GestoreClient attivi, ciascuno
  con il proprio thread daemon
  di lettura.
end note

A -> CS : Clicca "Stop Server"
CS -> RETE : stop()

RETE -> RETE : running = false
RETE -> RETE : serverSocket.close()
RETE -> ACCEPT : interrompe il blocco su accept()\n(SocketException gestita)
ACCEPT -> ACCEPT : termina ciclo di accettazione\n(thread daemon esce)

loop per ogni GestoreClient attivo
  RETE -> GC : richiede chiusura\n(o GC intercetta\nSocketException sul read)
  GC -> COORD : onClientDisconnesso(client)
  COORD -> COORD : rimuove client da\ngiocatoriInAttesa /\nannulla eventuale sfida attiva
  GC -> GC : chiude socket, out, in
end

RETE --> CS : log "Server arrestato"
CS --> A : Aggiorna stato GUI\n(pulsante "Avvia Server" riabilitato,\n"Stop Server" disabilitato)

note over CS
  Il database (GestoreDatabase, Singleton)
  resta connesso fino alla chiusura
  dell'applicazione: lo stop del server
  riguarda solo ReteServer (ServerSocket
  e connessioni client attive), non la
  persistenza SQLite.
end note
@enduml
