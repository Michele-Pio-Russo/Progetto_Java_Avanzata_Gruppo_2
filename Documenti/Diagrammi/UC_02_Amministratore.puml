@startuml UC_02_Amministratore
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Casi d'Uso - Amministratore

actor "Amministratore" as Admin
actor "Sistema\n(Server)" as Server

rectangle "Interfaccia Amministratore — IndovinaLaParola" {

  usecase "Login" as A01
  usecase "Verifica credenziali\nnel database (SHA-256)" as A01s

  usecase "Caricamento file TXT\ndal filesystem" as A02
  usecase "FileChooser\nmulti-selezione" as A02s

  usecase "Avvio analisi\nTerm Frequency" as A03
  usecase "ServizioAnalisi\n(JavaFX Service)" as A03s
  usecase "AnalizzatoreDocumenti" as A03t

  usecase "Salvataggio analisi\nserializzata (.dat)" as A04

  usecase "Caricamento analisi\nprecedentemente salvata" as A05

  usecase "Visualizzazione classifiche\ne statistiche utenti" as A06
  usecase "GestoreDatabase" as A06s
}

Admin --> A01
Admin --> A02
Admin --> A03
Admin --> A04
Admin --> A05
Admin --> A06

Server --> A01 : autentica

A01 ..> A01s : <<include>>
A02 ..> A02s : <<include>>
A03 ..> A03s : <<include>>
A03 ..> A03t : <<include>>
A06 ..> A06s : <<include>>

A04 ..> A03 : <<extend>>\nse analisi completata
A05 ..> A03 : <<extend>>\nevita rielaborazione

note right of A03s
  L'analisi dei file avviene in background
  tramite un Service di JavaFX, in modo
  da non bloccare l'interfaccia grafica.
end note

note bottom of A03t
  Il calcolo delle frequenze delle parole (TF)
  viene eseguito usando le Stream API di Java.
end note

@enduml
