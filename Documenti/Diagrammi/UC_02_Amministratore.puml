@startuml UC_02_Amministratore
' Descrizione del diagramma:
' Diagramma dei Casi d'Uso focalizzato sulle operazioni disponibili per l'Amministratore.
'
' Componenti principali:
' - Amministratore (Attore): Interagisce unicamente con l'interfaccia Server.
' - Azioni: Avvio/Stop, scelta del file di configurazione, avvio dell'analisi testo (TF-IDF),
'   osservazione dei Log di rete ed esplorazione delle statistiche dei giocatori.
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title UC_02 — Casi d'Uso Amministratore

actor "Amministratore" as A
actor "Sistema\n(ServizioAnalisi/ReteServer)" as S

rectangle "Modulo Amministrazione" {
  usecase "UC-A01\nLogin amministratore" as UCA01
  usecase "UC-A06\nAvvio/Stop server" as UCA06
  usecase "UC-A02\nSelezione file .txt" as UCA02
  usecase "UC-A03\nAvvio analisi TF" as UCA03
  usecase "UC-A04\nSalvataggio analisi (.dat)" as UCA04
  usecase "UC-A05\nCaricamento analisi (.dat)" as UCA05
  usecase "UC-A07\nVisualizzazione classifica" as UCA07

  usecase "Verifica credenziali\n(admin/admin123)" as UCA_CHECK
  usecase "Apertura ServerSocket\n(porta da .properties)" as UCA_SOCKET
  usecase "Pipeline Stream TF\n(filter->groupingBy->toMap)" as UCA_TF
  usecase "Binding ProgressBar /\nLabel progresso" as UCA_PROG
  usecase "Serializzazione OOS/OIS\n(AnalizzatoreDocumenti)" as UCA_SER
  usecase "Interrogazione getAllStats()" as UCA_STATS
  usecase "Popolamento TableView\n(top-500 / classifica)" as UCA_TABLE
}

A -- UCA01
A -- UCA06
A -- UCA02
A -- UCA03
A -- UCA04
A -- UCA05
A -- UCA07

S -- UCA_CHECK
S -- UCA_SOCKET
S -- UCA_TF
S -- UCA_PROG
S -- UCA_SER
S -- UCA_STATS

UCA01 ..> UCA_CHECK  : <<include>>
UCA06 ..> UCA_SOCKET : <<include>>

UCA03 ..> UCA_TF   : <<include>>
UCA03 ..> UCA02    : <<extend>>
UCA_TF ..> UCA_PROG : <<include>>
UCA03 ..> UCA_TABLE : <<extend>>

UCA04 ..> UCA_SER : <<include>>
UCA05 ..> UCA_SER : <<include>>

UCA07 ..> UCA_STATS : <<include>>
UCA_STATS ..> UCA_TABLE : <<include>>

note right of UCA01
  L'admin accede con admin/admin123;
  il server verifica nel DB
  (hash SHA-256) e abilita la GUI
  di gestione.
end note

note bottom of UCA03
  Il Task interno di ServizioAnalisi
  tokenizza il testo (regex [^a-zA-Z\\s])
  e calcola la TF; la GUI resta reattiva
  grazie al binding su progressProperty
  e messageProperty (Platform.runLater).
end note
@enduml
