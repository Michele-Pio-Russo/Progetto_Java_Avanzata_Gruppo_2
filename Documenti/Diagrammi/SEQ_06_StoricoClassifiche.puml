@startuml SEQ_06_StoricoClassifiche
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ-06 — Visualizzazione Storico e Classifiche (UC-A06, UC-G06)\n(Flusso Admin: classifiche | Flusso Giocatore: storico personale)

actor "Amministratore" as Admin
actor "Giocatore" as Player
participant "ControllerServer\n(server.fxml)" as AdminCtrl
participant "GestoreDatabase" as DB
participant "ControllerGioco\n(game.fxml)" as GC
participant "ControllerStorico\n(history.fxml)" as SC
participant "ConnessioneServer\n(TCP)" as Conn
participant "CoordinatoreGioco\n(server)" as Coord
database "SQLite\n(users, results, challenges)" as SQLite

== Flusso Amministratore: Visualizzazione Classifiche (UC-A06) ==

Admin -> AdminCtrl : preme "Aggiorna Classifiche"\n(handleRefreshStats)
activate AdminCtrl

AdminCtrl -> DB : db.getAllStats()
activate DB
DB -> SQLite : SELECT u.nomeUtente,\n  SUM(CASE WHEN esito='win' THEN 1 ELSE 0 END) AS wins,\n  COUNT(*) AS games_played,\n  AVG(CASE WHEN response_time_ms>=0\n      THEN response_time_ms END) AS avg_ms\nFROM results r JOIN users u\nGROUP BY r.user_id\nORDER BY wins DESC
activate SQLite
SQLite --> DB : ResultSet
deactivate SQLite
DB --> AdminCtrl : List<UserStats>\n(nomeUtente, wins, gamesPlayed, avgResponseMs)
deactivate DB

AdminCtrl -> AdminCtrl : FXCollections.observableArrayList\npopola statsTableView con StatEntry
AdminCtrl -> AdminCtrl : log "Classifica aggiornata: N utenti."
AdminCtrl --> Admin : mostra tabella classifiche\n(colonne: utente, vittorie, partite, tempo medio ms)

deactivate AdminCtrl

== Flusso Giocatore: Storico Personale (UC-G06) ==

Player -> GC : preme "Vedi storico"\n(dopo CHALLENGE_RESULT)
activate GC

GC -> GC : gestisciVisualizzaStorico()\nFXMLLoader.load("/fxml/history.fxml")
GC -> SC : hc.init(nomeUtente, connessione, stage, root)
activate SC

SC -> SC : configuraTabella()\nimposta CellValueFactory lambda (Modulo 4)\ne CellFactory per colorazione esito
SC -> Conn : connessione.setMessageCallback\n(msg -> gestisciMessaggio(msg))
SC -> Conn : connessione.invia(HISTORY_REQUEST, null)
activate Conn
Conn -> Coord : GestoreClient → smistaMessaggio\n→ gestisciRichiestaStorico(client)
activate Coord
Coord -> DB : db.getHistory(nomeUtente)
activate DB
DB -> SQLite : SELECT c.played_at, c.original_word,\n  r.esito, r.response_time_ms, avversario\nFROM results r\nJOIN challenges c ON r.challenge_id=c.challenge_id\nJOIN users u ON r.user_id=u.user_id\nWHERE u.nomeUtente = ?\nORDER BY c.played_at DESC
activate SQLite
SQLite --> DB : ResultSet
deactivate SQLite
DB --> Coord : List<VoceStorico>
deactivate DB

Coord -> Conn : GestoreClient.invia(\n  HISTORY_RESPONSE,\n  ArrayList<VoceStorico>)
deactivate Coord
Conn -> SC : callbackMessaggio.accept(HISTORY_RESPONSE)
deactivate Conn

SC -> SC : Platform.runLater:\nhistoryTable.setItems(\n  FXCollections.observableArrayList(entries))

note right of SC
  CellFactory per colonna esito:
  "Vinto"    → testo verde (#3fb950)
  "Perso"    → testo rosso (#f85149)
  "Pareggio" → testo giallo (#e3b341)
  Colonna tempo: -1 → "—" (timeout)
end note

SC --> Player : mostra tabella storico\n(data, avversario, esito, parola, tempo ms)

Player -> SC : preme "Indietro"
SC -> GC : FXMLLoader.load("game.fxml")\ngc.init(nomeUtente, connessione,\n"In attesa di un nuovo avversario...")
SC -> SC : stage.setScene(nuova scena game)
deactivate SC
deactivate GC
SC --> Player : torna alla schermata di gioco

@enduml
