@startuml UC_04_SfidaDettaglio
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Casi d'Uso - Dettaglio Sfida

actor "Giocatore 1" as P1
actor "Giocatore 2" as P2
actor "Sistema\n(Server)" as Server
database "DB SQLite\n(challenges, results)" as DB

rectangle "Flusso Sfida — CoordinatoreGioco" {

  usecase "Selezione estratto\n(AnalizzatoreDocumenti)" as UC_Select

  usecase "Scelta parola per TF" as UC_Word

  usecase "Cifratura con\nCifrario di Cesare" as UC_Cipher

  usecase "Invio CHALLENGE_START\na entrambi i client" as UC_Send

  usecase "Visualizzazione testo\ne avvio timer" as UC_Display

  usecase "Inserimento e invio\nrisposta (CHALLENGE_ANSWER)" as UC_Answer

  usecase "Validazione risposta\n(case-insensitive)" as UC_Validate

  usecase "Dichiarazione vincitore\ne notifica CHALLENGE_RESULT" as UC_Winner

  usecase "Salvataggio in\ntransazione DB" as UC_Save

  usecase "Gestione timeout\n(60 secondi)" as UC_Timeout
  usecase "Pareggio —\nCHALLENGE_RESULT\nesito PAREGGIO" as UC_Draw
}

Server --> UC_Select
Server --> UC_Word
Server --> UC_Cipher
Server --> UC_Send
Server --> UC_Validate
Server --> UC_Winner
Server --> UC_Save
Server --> UC_Timeout

P1 --> UC_Display
P1 --> UC_Answer
P2 --> UC_Display
P2 --> UC_Answer

UC_Select   ..> UC_Word   : <<include>>
UC_Word     ..> UC_Cipher : <<include>>
UC_Cipher   ..> UC_Send   : <<include>>
UC_Send     ..> UC_Display : <<include>>
UC_Answer   ..> UC_Validate : <<include>>
UC_Validate ..> UC_Winner   : <<include>>\nrisposta corretta
UC_Winner   ..> UC_Save     : <<include>>

UC_Timeout ..> UC_Draw : <<extend>>\nnessuno risponde entro 60s
UC_Draw    ..> UC_Save : <<include>>

UC_Save ..> DB : <<usa>>

note top of UC_Select
  Pre-condizioni:
  - I due giocatori sono loggati e in attesa
  - Il server ha dei documenti analizzati pronti
end note

note right of UC_Cipher
  Cifra la parola selezionata con uno shift casuale tra 1 e 25.
  Sostituisce la parola originale all'interno dell'estratto con quella cifrata.
end note

note bottom of UC_Save
  Post-condizioni:
  - I dati della partita vengono salvati in SQLite (tabella challenges).
  - I risultati dei due giocatori vengono inseriti come righe collegate (tabella results).
  - L'operazione è eseguita all'interno di una transazione.
end note

note left of UC_Timeout
  Se nessuno dei due giocatori indovina entro 60 secondi:
  - La sfida viene interrotta.
  - Viene assegnato un pareggio (draw) ad entrambi.
end note

@enduml
