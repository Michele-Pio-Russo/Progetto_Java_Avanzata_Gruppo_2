@startuml SEQ_01_Registrazione
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title Diagramma di Sequenza - Registrazione Giocatore

actor "Giocatore" as Player
participant "ControllerAccesso\n(login.fxml)" as Ctrl
participant "ConnessioneServer\n(TCP)" as Conn
participant "GestoreClient\n(thread daemon)" as GC
participant "CoordinatoreGioco" as Coord
participant "GestoreDatabase" as DB
database "SQLite\n(users)" as SQLite

Player -> Ctrl : inserisce nomeUtente e password\npreme "Registrati"
activate Ctrl

Ctrl -> Ctrl : valida input\n(campi non vuoti)

alt input non valido
  Ctrl --> Player : mostra errore "Username e password\nsono obbligatori"
end

Ctrl -> Conn : invia(REGISTER_REQUEST,\nPayloadAutenticazione(nomeUtente, password))
activate Conn
Conn -> GC : trasmette sul socket TCP
activate GC

GC -> GC : smistaMessaggio(msg)\n→ case REGISTER_REQUEST
GC -> Coord : gestisciRegistrazione(client, payload)
activate Coord

Coord -> Coord : valida payload\n(nomeUtente e password non vuoti)

Coord -> DB : registraUtente(nomeUtente, password)
activate DB
DB -> DB : hashPassword(password)\n(SHA-256)
DB -> SQLite : INSERT INTO users\n(nomeUtente, password_hash, ruolo='player')
activate SQLite

alt username gia' esistente (violazione UNIQUE)
  SQLite --> DB : SQLException (UNIQUE constraint)
  DB --> Coord : return false
  Coord -> GC : invia(REGISTER_RESPONSE,\nRispostaAutenticazione(false,\n"Username gia' esistente."))
  GC -> Conn : socket → client
  Conn -> Ctrl : callbackMessaggio.accept(msg)
  Ctrl --> Player : mostra errore\n"Username gia' esistente"
else registrazione riuscita
  SQLite --> DB : OK
  deactivate SQLite
  DB --> Coord : return true
  deactivate DB
  Coord -> GC : invia(REGISTER_RESPONSE,\nRispostaAutenticazione(true,\n"Registrazione completata. Ora accedi."))
  deactivate Coord
  GC -> Conn : socket → client
  deactivate GC
  Conn -> Ctrl : callbackMessaggio.accept(msg)
  deactivate Conn
  Ctrl -> Ctrl : gestisciRispostaRegistrazione:\ntorna in modalita' login
  Ctrl --> Player : mostra conferma verde\n"Registrazione completata. Ora accedi."
end

deactivate Ctrl

@enduml
