@startuml SEQ_01_Registrazione
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_01 — Registrazione (UC-G01)

actor "Giocatore" as G
participant "ControllerAccesso" as CA
participant "ConnessioneServer" as CONN
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD
participant "GestoreDatabase" as DB_MGR
database "SQLite\n(users)" as DB

G -> CA : Inserisce username,\npassword, conferma password
CA -> CA : Valida campi:\nusername >= 3 caratteri,\npassword >= 4 caratteri,\nconferma == password

alt Validazione client OK
  CA -> CONN : invia(REGISTER_REQUEST,\nPayloadAutenticazione(user, pwd))
  CONN -> GC : invio su Socket TCP (OOS)
  GC -> COORD : gestisciRegistrazione(payload)
  COORD -> DB_MGR : registraUtente(nomeUtente, password)
  DB_MGR -> DB_MGR : hashPassword() -> SHA-256
  DB_MGR -> DB : SELECT user WHERE nomeUtente = ?

  alt Username non esistente
    DB --> DB_MGR : nessun risultato
    DB_MGR -> DB : INSERT INTO users\n(nomeUtente, password_hash, ruolo='player')
    DB --> DB_MGR : ok
    DB_MGR --> COORD : successo = true
    COORD -> GC : invia(REGISTER_RESPONSE,\nRispostaAutenticazione(true, "Registrazione ok", null))
  else Username gia' esistente
    DB --> DB_MGR : utente trovato
    DB_MGR --> COORD : successo = false
    COORD -> GC : invia(REGISTER_RESPONSE,\nRispostaAutenticazione(false, "Username gia' esistente", null))
  end

  GC --> CONN : REGISTER_RESPONSE (OIS)
  CONN --> CA : callbackMessaggio(messaggio)
  CA --> G : Mostra esito registrazione

else Validazione client fallita
  CA --> G : Mostra errore di validazione\n(campo vuoto / lunghezza minima\n/ conferma non corrispondente)
end
@enduml
