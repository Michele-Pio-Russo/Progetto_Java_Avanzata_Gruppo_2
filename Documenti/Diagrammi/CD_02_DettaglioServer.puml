package "service" {
  class AnalizzatoreDocumenti <<Serializable>> {
    -termFrequency : Map<String, Double> = HashMap<>()
    -aggregatedText : String = ""
    -{static} serialVersionUID : long = 1L
    -{static} LOGGER : Logger
    +analyze(files : List<File>) <<throws IOException>>
    +getTermFrequency() : Map<String,Double>
    +getAggregatedText() : String
    +hasResults() : boolean
    +extractRandomExcerpt(numWords : int) : String
    +selectWordFromExcerpt(excerpt : String, difficulty : int) : String
    +saveToFile(outputPath : String) <<throws IOException>>
    +{static} loadFromFile(inputPath : String) : AnalizzatoreDocumenti\n<<throws IOException, ClassNotFoundException>>
  }

  class ServizioAnalisi {
    -files : List<File>
    +setFiles(files : List<File>)
    #createTask() : Task<AnalizzatoreDocumenti>
    .. extends javafx.concurrent.Service<AnalizzatoreDocumenti> ..
  }
}

package "db" {
  class GestoreDatabase <<Singleton>> {
    -{static} instance : GestoreDatabase
    -dbPath : String
    -connessione : Connection
    -{static} LOGGER : Logger
    -GestoreDatabase(dbPath : String)
    +{static} getInstance(dbPath : String) : GestoreDatabase <<synchronized>>
    +connetti() <<throws SQLException>>
    +disconnetti()
    -initSchema() <<throws SQLException>>
    -seedAccounts() <<throws SQLException>>
    -insertUserIfAbsent(nomeUtente, password, ruolo : String) <<throws SQLException>>
    +{static} hashPassword(password : String) : String
    +autentica(nomeUtente : String, password : String) : String
    +registraUtente(nomeUtente : String, password : String) : boolean
    +getUserId(nomeUtente : String) : int
    -insertChallenge(estrattoTesto, encryptedWord, originalWord : String,\n  spostamento : int) : int <<throws SQLException>>
    -insertResult(idSfida : int, userId : int, esito : String,\n  tempoRispostaMs : long) <<throws SQLException>>
    +saveChallengeWithResults(estrattoTesto, encryptedWord, originalWord : String,\n  spostamento : int, winnerUser, loserUser : String,\n  draw : boolean, t1, t2 : long)
    +getHistory(nomeUtente : String) : List<VoceStorico>
    +getAllStats() : List<UserStats>
  }

  class UserStats {
    +nomeUtente : final String
    +wins : final int
    +gamesPlayed : final int
    +avgResponseMs : final long
    +UserStats(nomeUtente : String, wins : int,\n  gamesPlayed : int, avgResponseMs : long)
  }

  GestoreDatabase +-- UserStats
}

