    -db : GestoreDatabase
    -network : ReteServer
    -analysisService : ServizioAnalisi
    -currentAnalyzer : AnalizzatoreDocumenti
    -selectedFiles : List<File> = ArrayList<>()
    -serverPort : int = 5000
    -statusLabel, portLabel, progressLabel, dettaglio... : Label
    -startServerBtn, stopServerBtn, selectFilesBtn,\nanalyzeBtn, saveAnalysisBtn, loadAnalysisBtn,\nrefreshStatsBtn : Button
    -documentListView : ListView<String>
    -progressBar : ProgressBar
    -logArea : TextArea
    -tfTableView : TableView<TFEntry>
    -wordColumn : TableColumn<TFEntry,String>
    -freqColumn : TableColumn<TFEntry,Double>
    -statsTableView : TableView<StatEntry>
    -statUserCol : TableColumn<StatEntry,String>
    -statWinsCol : TableColumn<StatEntry,Integer>
    -statGamesCol : TableColumn<StatEntry,Integer>
    -statAvgCol : TableColumn<StatEntry,Long>
    -{static} LOGGER : Logger
    -{static} TIME_FMT : DateTimeFormatter
    +initialize(location : URL, resources : ResourceBundle)
    -handleStartServer()
    -handleStopServer()
    -handleSelectFiles()
    -handleClearFiles()
    -handleAnalyze()
    -handleSaveAnalysis()
    -handleLoadAnalysis()
    -handleRefreshStats()
    -handleClearLog()
    -setupTfTable()
    -setupStatsTable()
    -populateTfTable(tf : Map<String,Double>)
    -showAlert(tipo : Alert.AlertType, title, content : String)
    -log(msg : String)
  }

  class TFEntry {
    word : String
    frequency : Double
  }

  class StatEntry {
    nomeUtente : String
    wins, gamesPlayed : int
    avgResponseMs : long
  }

  ControllerServer +-- TFEntry
  ControllerServer +-- StatEntry
}

ApplicazioneServer --> ControllerServer : carica server.fxml
ApplicazioneServer --> CaricatoreConfigurazione

ReteServer "1" *-- "0..*" GestoreClient : crea/gestisce
GestoreClient --> CoordinatoreGioco : smista messaggi
CoordinatoreGioco --> GestoreDatabase
CoordinatoreGioco --> AnalizzatoreDocumenti
CoordinatoreGioco ..> "indovinaparola.common.CifrarioCesare" : usa

ControllerServer --> ReteServer : network
ControllerServer --> CoordinatoreGioco : coordinator
ControllerServer --> GestoreDatabase : db
ControllerServer --> ServizioAnalisi : analysisService
ControllerServer --> AnalizzatoreDocumenti : currentAnalyzer
ControllerServer ..> UserStats : getAllStats()
ServizioAnalisi ..> AnalizzatoreDocumenti : createTask() produce

note right of GestoreClient
  invia() è synchronized e chiama
  out.reset() dopo ogni writeObject
  (IF-S09). OOS inizializzato
  prima di OIS con flush()
  (IF-S08).
end note

note right of CoordinatoreGioco
  Tutti i metodi pubblici sono
  synchronized (IF-S22): l'istanza
  è condivisa tra i thread
  GestoreClient.
end note

note right of GestoreDatabase
  Singleton (getInstance lazy,
  synchronized). PreparedStatement
  per tutte le query.
  saveChallengeWithResults() in
  transazione atomica
  (setAutoCommit(false) ->
  commit()/rollback()).
end note

note bottom of ServizioAnalisi
  ServizioAnalisi estende
  javafx.concurrent.Service<AnalizzatoreDocumenti>:
  riusabile con reset()+start();
  createTask() esegue analisi
  in background senza bloccare
  il FX Application Thread.
end note
@enduml
