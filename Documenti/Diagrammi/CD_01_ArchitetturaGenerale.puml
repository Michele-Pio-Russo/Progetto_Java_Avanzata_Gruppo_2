@startuml CD_01_ArchitetturaGenerale
skinparam packageStyle rectangle
left to right direction

title CD_01 — Architettura Generale (Maven multi-modulo)

package "common\n(indovinaparola.common)" as COMMON {
  class Messaggio {
    -tipo : Tipo
    -carico : Object
    +getTipo()
    +getCarico()
  }
  enum "Messaggio.Tipo" as MTipo {
    LOGIN_REQUEST
    LOGIN_RESPONSE
    REGISTER_REQUEST
    REGISTER_RESPONSE
    WAITING
    CHALLENGE_START
    CHALLENGE_ANSWER
    CHALLENGE_RESULT
    HISTORY_REQUEST
    HISTORY_RESPONSE
    REQUEUE_REQUEST
    ERROR
    DISCONNECT
  }
  class PayloadAutenticazione
  class RispostaAutenticazione
  class PayloadSfida
  class RisultatoSfida {
    +enum Esito
  }
  class VoceStorico
  class CifrarioCesare <<utility>> {
    +{static} cifra(parola, spostamento)
    +{static} decifra(parola, spostamento)
  }

  Messaggio *-- MTipo
  RisultatoSfida +-- "Esito"
}

package "server\n(indovinaparola.server)" as SERVER {
  class ApplicazioneServer
  class ReteServer
  class GestoreClient
  class CoordinatoreGioco
  class AnalizzatoreDocumenti
  class ServizioAnalisi
  class GestoreDatabase <<Singleton>>
  class CaricatoreConfigurazione
  class ControllerServer

  ApplicazioneServer --> ControllerServer
  ApplicazioneServer --> CaricatoreConfigurazione
  ReteServer --> GestoreClient : crea
  ReteServer --> CoordinatoreGioco
  GestoreClient --> CoordinatoreGioco
  CoordinatoreGioco --> GestoreDatabase
  CoordinatoreGioco --> AnalizzatoreDocumenti
  CoordinatoreGioco --> CifrarioCesare
  ControllerServer --> ServizioAnalisi
  ServizioAnalisi --> AnalizzatoreDocumenti
}

package "client\n(indovinaparola.client)" as CLIENT {
  class ApplicazioneClient
  class ConnessioneServer
  class ConfigurazioneClient
  class ControllerAccesso
  class ControllerGioco
  class ControllerStorico

  ApplicazioneClient --> ControllerAccesso
  ApplicazioneClient --> ConfigurazioneClient
  ControllerAccesso --> ConnessioneServer
  ControllerAccesso --> ControllerGioco : carica game.fxml
  ControllerGioco --> ConnessioneServer
  ControllerGioco --> ControllerStorico : carica history.fxml
  ControllerStorico --> ConnessioneServer
}

COMMON <.. SERVER : usa (dipendenza)
COMMON <.. CLIENT : usa (dipendenza)
CLIENT ..> SERVER : comunica via\nSocket TCP\n(Messaggio Serializable)

note bottom of COMMON
  Artefatto: common.jar
  Classi Serializable condivise:
  Messaggio, CifrarioCesare,
  Payload e DTO vari.
end note

note bottom of SERVER
  Artefatto: server.jar
  GUI admin (JavaFX+FXML), rete,
  logica di gioco, analisi TF,
  persistenza SQLite.
end note

note bottom of CLIENT
  Artefatto: client.jar
  GUI login/gioco/storico
  (JavaFX+FXML), connessione
  socket, controller.
end note
@enduml
