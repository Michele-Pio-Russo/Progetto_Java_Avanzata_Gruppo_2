@startuml SEQ_02_Login
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title Diagramma di Sequenza - Login

actor "Utente\n(Giocatore o Admin)" as User
participant "ControllerAccesso\n(login.fxml)" as Ctrl
participant "ConnessioneServer\n(TCP)" as Conn
participant "GestoreClient\n(thread daemon)" as GC
participant "CoordinatoreGioco" as Coord
participant "GestoreDatabase" as DB
database "SQLite\n(users)" as SQLite

User -> Ctrl : inserisce nomeUtente e password\npreme "Accedi"
activate Ctrl

Ctrl -> Conn : invia(LOGIN_REQUEST,\nPayloadAutenticazione(nomeUtente, password))
activate Conn
Conn -> GC : trasmette sul socket TCP
activate GC

GC -> GC : smistaMessaggio\n→ case LOGIN_REQUEST
GC -> Coord : gestisciLogin(client, payload)
activate Coord

Coord -> DB : autentica(nomeUtente, password)
activate DB
DB -> DB : hashPassword(password)
DB -> SQLite : SELECT ruolo FROM users\nWHERE nomeUtente=? AND password_hash=?
activate SQLite
SQLite --> DB : record (o null)
deactivate SQLite

alt credenziali non valide
  DB --> Coord : return null
  Coord -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(false,\n"Credenziali non valide."))
  GC -> Conn : socket → client
  Conn -> Ctrl : callbackMessaggio
  Ctrl --> User : mostra errore

else ruolo = "admin"
  DB --> Coord : return "admin"
  deactivate DB
  Coord -> Coord : client.setNomeUtente / setRuolo\n/ setAutenticato(true)
  Coord -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(true,\n"Login effettuato.", "admin"))
  GC -> Conn : socket → client
  Conn -> Ctrl : callbackMessaggio
  Ctrl --> User : apre ControllerServer\n(interfaccia admin)

else ruolo = "player"
  DB --> Coord : return "player"
  deactivate DB
  Coord -> Coord : client.setAutenticato(true)
  Coord -> Coord : aggiungiInListaAttesa(client)
  Coord -> GC : invia(LOGIN_RESPONSE, success)\n+ invia(WAITING, "In attesa (1/2)")
  deactivate Coord
  GC -> Conn : socket → client
  deactivate GC
  Conn -> Ctrl : callbackMessaggio WAITING

  note right of Conn
    Per evitare race condition in ControllerAccesso:
    se si riceve WAITING, i messaggi successivi
    (es. CHALLENGE_START) vengono accodati in una
    ConcurrentLinkedQueue temporanea finché non viene
    mostrata e inizializzata la schermata di gioco.
  end note

  Conn -> Ctrl : naviga a game.fxml\n(vaiAGioco con pendingMessages)
  deactivate Conn
  Ctrl --> User : mostra schermata di attesa\n"In attesa dell'avversario... (1/2)"
end

deactivate Ctrl

@enduml
