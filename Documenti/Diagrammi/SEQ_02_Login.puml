@startuml SEQ_02_Login
' Descrizione del diagramma:
' Diagramma di Sequenza che illustra il processo di Login (Autenticazione).
'
' Componenti e flusso principale:
' 1. L'Utente inserisce nome e password nel ControllerAccesso.
' 2. Il Messaggio LOGIN_REQUEST viaggia attraverso il Socket al GestoreClient.
' 3. Il Server verifica le credenziali con il GestoreDatabase (hash password).
' 4. In caso di successo, il Client riceve LOGIN_RESPONSE positivo e carica
'    il ControllerGioco, entrando nella fase di attesa (WAITING).
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_02 — Login (UC-G02 / UC-A01) con biforcazione admin/giocatore

actor "Utente\n(Admin o Giocatore)" as U
participant "ControllerAccesso" as CA
participant "ConnessioneServer" as CONN
participant "GestoreClient" as GC
participant "CoordinatoreGioco" as COORD
participant "GestoreDatabase" as DB_MGR
database "SQLite\n(users)" as DB

U -> CA : Inserisce username e password,\npreme "Accedi"
CA -> CONN : invia(LOGIN_REQUEST,\nPayloadAutenticazione(user, pwd))
CONN -> GC : invio su Socket TCP (OOS, thread separato)
GC -> COORD : gestisciLogin(payload)
COORD -> DB_MGR : autentica(nomeUtente, password) : String
DB_MGR -> DB_MGR : hashPassword(password) -> SHA-256
DB_MGR -> DB : SELECT password_hash, ruolo\nFROM users WHERE nomeUtente = ?\nAND password_hash = ?
DB --> DB_MGR : ruolo (o nessuna riga)

alt Credenziali valide
  DB_MGR --> COORD : ruolo = "admin" | "player"
  COORD -> GC : setNomeUtente(), setRuolo(),\nsetAutenticato(true)

  alt ruolo == "player"
    COORD -> COORD : giocatoriInAttesa.add(client)\n(controllo duplicati IF-S23)
    COORD -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(true, msg, "player"))
    GC --> CONN : LOGIN_RESPONSE
    CONN --> CA : callbackMessaggio
    CA --> U : Carica game.fxml,\nmostra waitingPane
    COORD -> GC : invia(WAITING, "1/2")
    GC --> CONN : WAITING
    CONN --> CA : ControllerGioco.consegnaMessaggio()
    CA --> U : Aggiorna stato attesa

  else ruolo == "admin"
    COORD -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(true, msg, "admin"))
    GC --> CONN : LOGIN_RESPONSE
    CONN --> CA : callbackMessaggio
    CA --> U : Apre GUI Amministratore\n(ControllerServer)
  end

else Credenziali non valide
  DB_MGR --> COORD : ruolo = null
  COORD -> GC : invia(LOGIN_RESPONSE,\nRispostaAutenticazione(false,\n"Credenziali errate", null))
  GC --> CONN : LOGIN_RESPONSE
  CONN --> CA : callbackMessaggio
  CA --> U : Mostra messaggio di errore\nnella schermata di accesso
end
@enduml
