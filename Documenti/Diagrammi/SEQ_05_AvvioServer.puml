@startuml SEQ_05_AvvioServer
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title Diagramma di Sequenza - Avvio Server

actor "Amministratore\n/ Revisore" as Admin
participant "JVM\n(java -jar server.jar)" as JVM
participant "ApplicazioneServer\n(JavaFX Application)" as App
participant "ControllerServer\n(initialize)" as Ctrl
participant "CaricatoreConfigurazione" as Cfg
participant "GestoreDatabase\n(Singleton)" as DB
participant "CoordinatoreGioco" as Coord
participant "ReteServer" as Rete
participant "ServizioAnalisi\n(JavaFX Service)" as Svc
database "server.properties" as Props
database "SQLite\n(database.db)" as SQLite
database "File .dat\n(analisi)" as DatFile

Admin -> JVM : java -jar server.jar
activate JVM
JVM -> App : Application.launch()
activate App

App -> App : start(primaryStage)\nFXMLLoader.load("/fxml/server.fxml")

App -> Ctrl : initialize(location, resources)
activate Ctrl

Ctrl -> Cfg : new CaricatoreConfigurazione\n("properties/server.properties")
activate Cfg
Cfg -> Props : FileInputStream.load()
Props --> Cfg : server.porta=5000
Cfg --> Ctrl : serverPort = 5000
deactivate Cfg

Ctrl -> Ctrl : portLabel.setText("5000")

Ctrl -> DB : GestoreDatabase.getInstance("db/database.db")\n.connetti()
activate DB
DB -> DB : initSchema()\n(CREATE TABLE IF NOT EXISTS\nusers, challenges, results)
DB -> DB : seedAccounts()\n(INSERT IF NOT EXISTS\nadmin, giocatore1, giocatore2)
DB -> SQLite : esegue DDL e INSERT
SQLite --> DB : OK
DB --> Ctrl : connessione pronta
deactivate DB

Ctrl -> Coord : new CoordinatoreGioco(db, null)
activate Coord
Ctrl -> Coord : setStatusCallback(\n  msg -> Platform.runLater(\n    () -> logArea.appendText(msg)))\n[callback tramite espressione lambda]
deactivate Coord

Ctrl -> Svc : new ServizioAnalisi()\nprogressBar.progressProperty().bind(...)\nanalysisService.messageProperty().addListener(...)
activate Svc
Svc --> Ctrl : binding dichiarativo pronto
deactivate Svc

Ctrl --> App : inizializzazione completata
App -> App : primaryStage.show()\n"IndovinaLaParola - Server Amministratore"
App --> Admin : interfaccia admin visibile

Admin -> Ctrl : preme "Avvia Server"
Ctrl -> Rete : new ReteServer(5000, coordinator)\n.start()
activate Rete
Rete -> Rete : new ServerSocket(5000)\nrunning = true
Rete -> Rete : Thread daemon "ServerAcceptThread"\nacceptThread.start()
note right of Rete
  Loop: while(running) {
    Socket s = serverSocket.accept();
    new GestoreClient(s, coord).startListening();
  }
  Ogni GestoreClient avvia
  il proprio thread daemon di lettura.
end note
Rete --> Ctrl : server attivo
deactivate Rete

Ctrl -> Ctrl : statusLabel.setText("Server ATTIVO - porta 5000")
Ctrl --> Admin : log "[HH:mm:ss] Server avviato sulla porta 5000."

deactivate Ctrl
deactivate App
deactivate JVM

@enduml
