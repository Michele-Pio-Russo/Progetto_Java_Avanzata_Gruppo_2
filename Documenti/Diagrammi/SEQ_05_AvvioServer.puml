@startuml SEQ_05_AvvioServer
skinparam actorStyle awesome
skinparam sequenceMessageAlign center

title SEQ_05 — Avvio Server: properties, schema SQLite, ServerSocket, UI admin

actor "Amministratore" as A
participant "ApplicazioneServer\n(main)" as APP
participant "CaricatoreConfigurazione" as CFG
participant "GestoreDatabase\n(Singleton)" as DB_MGR
participant "ReteServer" as RETE
participant "CoordinatoreGioco" as COORD
participant "ControllerServer\n(GUI)" as CS
database "SQLite\n(database.db)" as DB

A -> APP : esegue "java -jar server.jar"
APP -> CFG : carica server.properties

alt file presente
  CFG --> APP : server.port, db.path,\nanalysis.save.path,\ngame.timeout.seconds,\ngame.excerpt.words
else file assente
  CFG -> CFG : log warning
  CFG --> APP : valori di default
end

APP -> DB_MGR : getInstance(db.path)
DB_MGR -> DB : connetti()
DB_MGR -> DB : initSchema()\n(CREATE TABLE IF NOT EXISTS\nusers, challenges, results)
DB_MGR -> DB : seedAccounts()\n(insertUserIfAbsent per\nadmin/giocatore1/giocatore2)
DB --> DB_MGR : schema pronto

APP -> COORD : crea CoordinatoreGioco(db, config)
APP -> RETE : crea ReteServer(port, coordinatore)
APP -> CS : avvia GUI JavaFX\n(ControllerServer, server.fxml)
CS --> A : Mostra finestra admin\n(pulsanti Avvia/Stop, Seleziona file,\nAvvia Analisi, ecc.)

A -> CS : Clicca "Avvia Server"
CS -> RETE : avvia()
RETE -> RETE : new ServerSocket(port)
RETE -> RETE : avvia ServerAcceptThread\n(thread daemon)
RETE --> CS : log "Server avviato sulla porta 5000"
CS --> A : Mostra log nella GUI

loop per ogni connessione client
  RETE -> RETE : accept()
  RETE -> RETE : crea GestoreClient dedicato
  RETE -> RETE : gestoreClient.startListening()\n(thread daemon, OOS prima di OIS + flush())
end
@enduml
