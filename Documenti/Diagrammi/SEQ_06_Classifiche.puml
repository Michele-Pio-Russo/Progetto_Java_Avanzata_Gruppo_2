@startuml SEQ_06_Classifiche
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequence {
    ArrowColor #2C3E50
    ActorBorderColor #1E8449
    ActorBackgroundColor #D5F5E3
    ParticipantBorderColor #1E8449
    ParticipantBackgroundColor #EAFAF1
    LifeLineBorderColor #BDC3C7
}

title <b>SEQ-06 – Visualizzazione Classifiche e Storico (UC-A06, UC-G06)</b>\n<i>GuessTheWord | Corso JA26 – A.A. 2025/2026</i>

actor "Amministratore\n/ Giocatore" as User
participant "UI\n(JavaFX/FXML)" as UI
participant "StatsService" as Stats
database "DB SQLite\n(users, results)" as DB

User -> UI : preme "Visualizza Classifiche"\no "Storico Personale"
activate UI

UI -> Stats : richiediStatistiche(userId?)
activate Stats

Stats -> DB : SELECT u.username,\nCOUNT(*) AS wins\nFROM results r\nJOIN users u ON r.user_id=u.user_id\nWHERE r.outcome='win'\nGROUP BY r.user_id\nORDER BY wins DESC
activate DB
DB --> Stats : lista (username, wins)
deactivate DB

Stats -> DB : SELECT u.username,\nCOUNT(*) AS games_played,\nAVG(r.response_time_ms)\nFROM results r\nJOIN users u ON r.user_id=u.user_id\nGROUP BY r.user_id
activate DB
DB --> Stats : lista (username, games, avg_ms)
deactivate DB

Stats --> UI : StatsDTO\n{classificaVittorie,\npartiteGiocate,\ntempoMedioRisposta}
deactivate Stats

UI --> User : visualizza tabella classifiche\n/ storico partite con esiti e date
deactivate UI

@enduml
