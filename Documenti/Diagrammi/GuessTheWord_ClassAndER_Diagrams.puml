  +getEsito() : Esito
}

enum "RisultatoSfida.Esito" as Esito {
  VITTORIA
  SCONFITTA
  PAREGGIO
  --
  +toDisplayString() : String
  +toEmoji() : String
}

class VoceStorico <<Serializable>> {
  -dataPartita : String
  -avversario : String
  -esito : String
  -tempoRispostaMs : long
  -parolaCorretta : String
  +VoceStorico(dataPartita : String, avversario : String,\n  esito : String, tempoRispostaMs : long, parolaCorretta : String)
  +getDataPartita() : String
