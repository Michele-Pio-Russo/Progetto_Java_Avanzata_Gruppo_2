}

class CifrarioCesare <<utility>> {
  -CifrarioCesare()
  +{static} cifra(parola : String, spostamento : int) : String
  +{static} decifra(parola : String, spostamento : int) : String
}

Messaggio "1" *-- "1" Tipo : tipo
Messaggio ..> PayloadAutenticazione : <<carico>>\n(LOGIN/REGISTER_REQUEST)
Messaggio ..> RispostaAutenticazione : <<carico>>\n(LOGIN/REGISTER_RESPONSE)
Messaggio ..> PayloadSfida : <<carico>>\n(CHALLENGE_START)
Messaggio ..> RisultatoSfida : <<carico>>\n(CHALLENGE_RESULT)
Messaggio ..> "List<VoceStorico>" : <<carico>>\n(HISTORY_RESPONSE)

RisultatoSfida "1" *-- "1" Esito : esito

PayloadSfida ..> CifrarioCesare : <<usa>>\n(parola cifrata da\nCoordinatoreGioco)

note bottom of Messaggio
  Classe base del protocollo, con
  serialVersionUID=1L: il campo tipo
  (enum a 13 valori) determina il cast
  del campo carico (Object) lato
  ricevente (DF-01, DF-02).
end note

note bottom of CifrarioCesare
  Utility class non istanziabile
  (costruttore privato). cifra/decifra
  sono simmetriche:
  decifra(x,k) = cifra(x,26-k) (DF-04).
end note

note bottom of VoceStorico
  Classe immutabile (tutti i campi
  final, nessun setter): DTO sicuro
  per ambiente multi-thread,
  compatibile JDK 8.
end note

note bottom of Esito
  toDisplayString(): "Hai vinto!" /
  "Hai perso." / "Pareggio!"
  toEmoji(): 🏆 / 😞 / 🤝  (DF-03)
end note
@enduml


@startuml CD_01_ArchitetturaGenerale
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
left to right direction

title CD_01 — Architettura Generale (package reali da Doxygen)

package "common\n(indovinaparola.common)" as COMMON {
  class Messaggio
  enum "Messaggio.Tipo" as MTipo
  class PayloadAutenticazione
  class RispostaAutenticazione
  class PayloadSfida
  class RisultatoSfida
  enum "RisultatoSfida.Esito" as Esito
  class VoceStorico
  class CifrarioCesare <<utility>>

  Messaggio *-- MTipo
  RisultatoSfida *-- Esito
}

package "server\n(indovinaparola.server)" as SERVER {

  class ApplicazioneServer <<JavaFX Application>>

  package "model" as S_MODEL {
    class ReteServer
    class GestoreClient
    class CoordinatoreGioco
  }

  package "db" as S_DB {
    class GestoreDatabase <<Singleton>>
    class "GestoreDatabase.UserStats" as UserStats
    GestoreDatabase +-- UserStats
  }

  package "service" as S_SERVICE {
    class AnalizzatoreDocumenti <<Serializable>>
    class ServizioAnalisi
  }

  package "controller" as S_CTRL {
    class ControllerServer <<Initializable>>
    class "ControllerServer.StatEntry" as StatEntry
    class "ControllerServer.TFEntry" as TFEntry
    ControllerServer +-- StatEntry
    ControllerServer +-- TFEntry
  }

  package "util" as S_UTIL {
    class CaricatoreConfigurazione
  }

  ApplicazioneServer --> ControllerServer : carica server.fxml

  ReteServer "1" *-- "0..*" GestoreClient : crea/gestisce
  GestoreClient --> CoordinatoreGioco : smista messaggi
  CoordinatoreGioco --> GestoreDatabase
  CoordinatoreGioco --> AnalizzatoreDocumenti

  ControllerServer --> ReteServer : network
  ControllerServer --> CoordinatoreGioco : coordinator
  ControllerServer --> GestoreDatabase : db
  ControllerServer --> ServizioAnalisi : analysisService
  ControllerServer --> AnalizzatoreDocumenti : currentAnalyzer
  ServizioAnalisi ..> AnalizzatoreDocumenti : produce (Service<T>)

  ApplicazioneServer --> CaricatoreConfigurazione
}

package "client\n(indovinaparola.client)" as CLIENT {

  class ApplicazioneClient <<JavaFX Application>>

  package "service" as C_SERVICE {
    class ConnessioneServer
  }

  package "util" as C_UTIL {
    class ConfigurazioneClient
  }

  package "controller" as C_CTRL {
    class ControllerAccesso <<Initializable>>
    class ControllerGioco
    class ControllerStorico
  }

  ApplicazioneClient --> ControllerAccesso : carica login.fxml
  ApplicazioneClient --> ConfigurazioneClient

  ControllerAccesso --> ConnessioneServer : crea/usa
  ControllerAccesso ..> ControllerGioco : carica game.fxml\n+ init()
  ControllerGioco --> ConnessioneServer
  ControllerGioco ..> ControllerStorico : carica history.fxml\n+ init()
  ControllerStorico --> ConnessioneServer
}

COMMON <.. SERVER : usa (common.jar)
COMMON <.. CLIENT : usa (common.jar)
CLIENT ..> SERVER : comunica via\nSocket TCP\n(Messaggio Serializable)

note bottom of S_MODEL
  network + game logic:
  ReteServer (ServerSocket, accept thread),
  GestoreClient (1 per connessione,
  thread daemon di lettura),
  CoordinatoreGioco (logica di gioco,
  metodi synchronized).
end note

note bottom of S_DB
  Persistenza SQLite via JDBC.
  GestoreDatabase: Singleton,
  PreparedStatement, transazioni.
  UserStats: DTO classifica
  (nomeUtente, wins, gamesPlayed,
  avgResponseMs).
end note

note bottom of S_SERVICE
  AnalizzatoreDocumenti: calcolo TF
  (Stream API), estratto ed estrazione
  parola, Serializable (.dat).
  ServizioAnalisi extends
  javafx.concurrent.Service<AnalizzatoreDocumenti>.
end note

note bottom of C_SERVICE
  ConnessioneServer: Socket TCP,
  OOS prima di OIS + flush(),
  thread daemon di lettura,
  invia() synchronized + reset(),
  callback su messaggio/disconnessione.
end note
@enduml


