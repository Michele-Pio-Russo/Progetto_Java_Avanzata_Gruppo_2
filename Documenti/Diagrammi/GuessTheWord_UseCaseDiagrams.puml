}

ADMIN -- UC_LOGIN
ADMIN -- UC_DOC
ADMIN -- UC_SRV
ADMIN -- UC_CLASS

PLAYER -- UC_LOGIN
PLAYER -- UC_REG
PLAYER -- UC_ATTESA
PLAYER -- UC_SFIDA
PLAYER -- UC_ESITO
PLAYER -- UC_STORICO

SERVER -- UC_ATTESA
