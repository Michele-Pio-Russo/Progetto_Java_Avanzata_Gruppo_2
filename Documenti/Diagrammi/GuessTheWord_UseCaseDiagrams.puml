@enduml


' ============================================================
'  DIAGRAMMA 3 – Use Case Giocatore
'  Dettaglio dei casi d'uso riservati al Giocatore
' ============================================================

@startuml UC_03_Giocatore
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EBF5FB
    BorderColor #1A6FA8
    FontColor #1A252F
    ArrowColor #2C3E50
}
skinparam actor {
    BackgroundColor #D6EAF8
    BorderColor #1A5276
    FontColor #1A252F
}

title <b>GuessTheWord – Casi d'Uso: Giocatore</b>\n<i>Corso JA26 – A.A. 2025/2026</i>

actor "Giocatore" as Player
actor "Server\n(Sistema)" as Server <<system>>

rectangle "Applicazione Client – GuessTheWord" {

    ' ---- UC-G01 ----
    usecase "UC-G01\nRegistrazione" as G01
    usecase "Invio Dati\nal Server" as G01_send
    usecase "Verifica Unicità\nUsername" as G01_check

    ' ---- UC-G02 ----
    usecase "UC-G02\nLogin" as G02
    usecase "Autenticazione\nCredenziali" as G02_auth

    ' ---- UC-G03 ----
    usecase "UC-G03\nAttesa Avversario" as G03
    usecase "Visualizzazione\nStato Attesa" as G03_wait

    ' ---- UC-G04 ----
    usecase "UC-G04\nPartecipazione alla Sfida" as G04
    usecase "Visualizzazione\nTesto Cifrato" as G04_view
    usecase "Inserimento e\nInvio Risposta" as G04_answer
    usecase "Monitoraggio\nTimer" as G04_timer
    usecase "Indicatore\nStato Partita" as G04_status

    ' ---- UC-G05 ----
    usecase "UC-G05\nVisualizzazione Esito" as G05

    ' ---- UC-G06 ----
    usecase "UC-G06\nVisualizzazione Storico\nPartite Personali" as G06
}

' === RELAZIONI ===
Player --> G01
Player --> G02
Player --> G03
Player --> G04
Player --> G05
Player --> G06

Server --> G02 : valida
Server --> G03 : notifica connessione\n2° client
Server --> G04 : invia testo cifrato\ne timeout
Server --> G05 : invia esito

G01 ..> G01_send  : <<include>>
G01 ..> G01_check : <<include>>
G02 ..> G02_auth  : <<include>>
G03 ..> G03_wait  : <<include>>
G04 ..> G04_view   : <<include>>
G04 ..> G04_answer : <<include>>
G04 ..> G04_timer  : <<include>>
G04 ..> G04_status : <<include>>

G02 ..> G03 : <<extend>>\ndopo login OK
G03 ..> G04 : <<extend>>\nquando entrambi connessi
G04 ..> G05 : <<extend>>\nal termine sfida

note top of G01
  Post-condizione:
  Utente creato nel DB con ruolo "player".
  Username deve essere univoco (RF-SRV-05).
end note

note right of G04
  Flusso principale UC-G04:
  1. Ricezione testo con parole cifrate
  2. Avvio conto alla rovescia
  3. Inserimento risposta
  4. Invio al server
  5. Ricezione esito
  Flusso alternativo: Timeout → pareggio
end note

note bottom of G06
  SHOULD (RF-CLT-10):
  Lo storico mostra esiti
  e date delle partite precedenti.
end note

@enduml


' ============================================================
'  DIAGRAMMA 4 – UC-G04 Dettagliato: Partecipazione alla Sfida
'  Caso d'uso principale con flusso principale e alternativo
' ============================================================

@startuml UC_04_Sfida_Dettagliato
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #FEF9E7
    BorderColor #B7950B
    FontColor #1A252F
    ArrowColor #2C3E50
}
skinparam actor {
    BackgroundColor #FDF2E9
    BorderColor #1A5276
    FontColor #1A252F
}

title <b>GuessTheWord – UC-G04: Partecipazione alla Sfida (Dettaglio)</b>\n<i>Corso JA26 – A.A. 2025/2026</i>

actor "Giocatore 1" as P1
actor "Giocatore 2" as P2
actor "Server\n(Sistema)" as Server <<system>>
database "DB SQLite" as DB <<system>>

rectangle "Sistema GuessTheWord – Flusso Sfida" {

    usecase "Selezione Estratto\nTestuale" as UC_Select
    usecase "Cifratura con\nCifrario di Cesare\n(shift casuale)" as UC_Encrypt
    usecase "Invio Testo Cifrato\ne Timeout ai Client" as UC_Send
    usecase "Visualizzazione\nTesto + Timer" as UC_Display
    usecase "Inserimento\nRisposta" as UC_Input
    usecase "Validazione\nRisposta (case-insensitive)" as UC_Validate
    usecase "Dichiarazione\nVincitore" as UC_Winner
    usecase "Notifica Esito\na Entrambi i Client" as UC_Notify
    usecase "Registrazione Esito\nnel Database" as UC_SaveResult

    usecase "Gestione Timeout\n(nessuna risposta corretta)" as UC_Timeout
    usecase "Pareggio /\nNessun Vincitore" as UC_Draw
}

' === RELAZIONI ===
Server --> UC_Select
Server --> UC_Encrypt
Server --> UC_Send
Server --> UC_Validate
Server --> UC_Winner
Server --> UC_Notify
Server --> UC_SaveResult
Server --> UC_Timeout

P1 --> UC_Display
P1 --> UC_Input

P2 --> UC_Display
P2 --> UC_Input

UC_Select   ..> UC_Encrypt  : <<include>>
UC_Encrypt  ..> UC_Send     : <<include>>
UC_Send     ..> UC_Display  : <<include>>
UC_Input    ..> UC_Validate : <<include>>
UC_Validate ..> UC_Winner   : <<include>>\nse risposta corretta
UC_Winner   ..> UC_Notify   : <<include>>
UC_Notify   ..> UC_SaveResult : <<include>>

UC_Timeout ..> UC_Draw     : <<extend>>\nse timeout scade
UC_Draw    ..> UC_SaveResult : <<include>>

UC_SaveResult ..> DB : <<usa>>

note top of UC_Select
  Pre-condizioni:
  • Entrambi i giocatori autenticati
  • Almeno un documento analizzato
    disponibile nel server (RF-SRV-10)
end note

note right of UC_Encrypt
  Cifrario di Cesare:
  E(c) = (c - 'A' + k) mod 26 + 'A'
  shift k scelto casualmente (1 ≤ k ≤ 25)
  (RF-SRV-12, Appendice C)
end note

note bottom of UC_SaveResult
  Post-condizioni:
  • Esito registrato nel DB (RF-SRV-16)
  • Entrambi i client mostrano il risultato
  • Tabella results: winner, loser, timestamp
end note

note left of UC_Timeout
  Flusso Alternativo A:
  Se nessun giocatore risponde
  correttamente entro il timeout,
  la sfida termina in pareggio.
  Outcome = "draw" nel DB.
end note

@enduml


' ============================================================
'  DIAGRAMMA 5 – Use Case: Persistenza e Database
'  Interazioni tra sistema e database SQLite
' ============================================================

@startuml UC_05_Persistenza
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome
