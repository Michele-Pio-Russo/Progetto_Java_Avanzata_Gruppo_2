' UC_06 — Configurazione e Avvio
' ============================================================
@startuml UC_06_ConfigurazioneAvvio
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor MistyRose
  BorderColor Crimson
}

title UC_06 — Configurazione e Avvio del Sistema

actor "Amministratore" as A
actor "Giocatore" as G
actor "Sistema" as S

rectangle "Modulo Configurazione e Avvio" {
  usecase "Avviare server.jar\n(java -jar)" as UC_SRV_START
  usecase "Avviare client.jar\n(java -jar)" as UC_CLI_START

  usecase "Leggere server.properties\n(CaricatoreConfigurazione)" as UC_SRV_PROP
  usecase "Leggere client.properties\n(ConfigurazioneClient)" as UC_CLI_PROP
  usecase "Usare valori di default\nse file assente" as UC_DEFAULT
  usecase "Inizializzare schema DB\n(initSchema + seed)" as UC_INIT_DB
  usecase "Aprire ServerSocket\nsu porta configurata" as UC_OPEN_SOCKET
  usecase "Connettere Socket TCP\na server.ip:server.port" as UC_CONNECT
  usecase "Inizializzare OOS\nprima di OIS + flush()" as UC_STREAMS
}

A -- UC_SRV_START
G -- UC_CLI_START
S -- UC_INIT_DB

UC_SRV_START ..> UC_SRV_PROP : <<include>>
UC_CLI_START ..> UC_CLI_PROP : <<include>>

UC_SRV_PROP ..> UC_DEFAULT : <<extend>>\n(file non trovato)
UC_CLI_PROP ..> UC_DEFAULT : <<extend>>\n(file non trovato)

UC_SRV_START ..> UC_INIT_DB     : <<include>>
UC_SRV_START ..> UC_OPEN_SOCKET : <<include>>
UC_CLI_START ..> UC_CONNECT     : <<include>>

UC_OPEN_SOCKET ..> UC_STREAMS : <<include>>
UC_CONNECT     ..> UC_STREAMS : <<include>>

note right of UC_SRV_PROP
  Chiavi: server.port (default 5000),
  db.path (default db/database.db),
  analysis.save.path
  (default data/analysis.dat),
  game.timeout.seconds (default 60),
  game.excerpt.words (default 60).
  Se il file manca, il server prosegue
  con i default loggando un avviso
  (non termina con eccezione).
end note

note right of UC_CLI_PROP
  Chiavi: server.ip (default 127.0.0.1),
  server.port (default 5000).
  Fallback automatico sui default
  se client.properties e' assente.
end note

note bottom of UC_STREAMS
  Regola fondamentale (entrambi i lati):
  ObjectOutputStream creato PRIMA di
  ObjectInputStream, con out.flush()
  immediato dopo la costruzione di OOS,
  per evitare il deadlock nel costruttore
  di OIS.
end note
@enduml


' ============================================================
' UC_07 — Protocollo Client <-> Server
' ============================================================
@startuml UC_07_Protocollo
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor Wheat
  BorderColor SaddleBrown
}

title UC_07 — Protocollo di Comunicazione Client <-> Server

actor "Client\n(Giocatore/Admin)" as C
actor "Server\n(GestoreClient)" as S

rectangle "Protocollo (Messaggio.Tipo - enum a 13 valori)" {
  usecase "LOGIN_REQUEST /\nLOGIN_RESPONSE" as M_LOGIN
  usecase "REGISTER_REQUEST /\nREGISTER_RESPONSE" as M_REG
  usecase "WAITING" as M_WAIT
  usecase "CHALLENGE_START" as M_START
  usecase "CHALLENGE_ANSWER" as M_ANS
  usecase "CHALLENGE_RESULT" as M_RESULT
  usecase "HISTORY_REQUEST /\nHISTORY_RESPONSE" as M_HIST
  usecase "REQUEUE_REQUEST" as M_REQUEUE
  usecase "ERROR" as M_ERR
  usecase "DISCONNECT" as M_DISC

  usecase "invia()\nsynchronized + out.reset()" as UC_INVIA
  usecase "Smistamento tramite\nswitch su Messaggio.Tipo" as UC_SWITCH
}

C --> M_LOGIN
C --> M_REG
C --> M_ANS
C --> M_HIST
C --> M_REQUEUE
C --> M_DISC

S --> M_LOGIN
S --> M_REG
S --> M_WAIT
S --> M_START
S --> M_RESULT
S --> M_HIST
S --> M_ERR

M_LOGIN ..> UC_INVIA : <<include>>
M_REG ..> UC_INVIA : <<include>>
M_START ..> UC_INVIA : <<include>>
M_RESULT ..> UC_INVIA : <<include>>
M_HIST ..> UC_INVIA : <<include>>

UC_SWITCH ..> M_LOGIN  : <<include>>
UC_SWITCH ..> M_REG    : <<include>>
UC_SWITCH ..> M_ANS    : <<include>>
UC_SWITCH ..> M_HIST   : <<include>>
UC_SWITCH ..> M_REQUEUE: <<include>>
UC_SWITCH ..> M_DISC   : <<include>>

note right of M_LOGIN
  Payload: PayloadAutenticazione
  (nomeUtente, password) /
  RispostaAutenticazione
  (successo, messaggio, ruolo)
end note

note right of M_START
  Payload: PayloadSfida(idSfida,
  estrattoTesto, paroleCifrate,
  secondiTimeout)
end note

note right of M_RESULT
  Payload: RisultatoSfida
  (nomeUtenteVincitore, parolaCorretta,
  Esito: VITTORIA/SCONFITTA/PAREGGIO)
end note

note right of UC_INVIA
  Ogni writeObject e' seguito da
  out.reset() per evitare il caching
  degli oggetti serializzati di OOS
  (IF-S09 / IF-C03).
end note

note bottom of UC_SWITCH
  GestoreClient smista i messaggi al
  CoordinatoreGioco; i tipi non gestiti
  vengono loggati come warning (IF-S10).
end note
@enduml
