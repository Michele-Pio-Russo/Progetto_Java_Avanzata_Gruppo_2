    ' ---- UC-A02 ----
    usecase "UC-A02\nCaricamento Documenti TXT" as A02
    usecase "Selezione File\ndal Filesystem" as A02_sub

    ' ---- UC-A03 ----
    usecase "UC-A03\nAvvio Analisi Term Frequency" as A03
    usecase "Elaborazione Asincrona\n(JavaFX Service/Task)" as A03_sub
    usecase "Calcolo TF\ncon Stream API" as A03_tf

    ' ---- UC-A04 ----
    usecase "UC-A04\nSalvataggio Analisi\nin Formato Serializzato" as A04

    ' ---- UC-A05 ----
