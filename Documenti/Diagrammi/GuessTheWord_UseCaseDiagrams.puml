' ============================================================
'  DIAGRAMMA 7 – Diagramma di Comunicazione Client-Server
'  Protocollo messaggi (Appendice B dell'SRS)
' ============================================================

@startuml UC_07_Protocollo_Comunicazione
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #E8F8F5
    BorderColor #1ABC9C
    FontColor #1A252F
    ArrowColor #2C3E50
}
skinparam actor {
    BackgroundColor #D1F2EB
    BorderColor #0E6655
    FontColor #1A252F
}

title <b>GuessTheWord – Casi d'Uso: Protocollo di Comunicazione Client↔Server</b>\n<i>Corso JA26 – A.A. 2025/2026 | Appendice B – SRS</i>

actor "Client\n(Giocatore)" as Client
actor "Server\n(Sistema)" as Server <<system>>

rectangle "Flusso di Comunicazione via Socket TCP" {

    usecase "UC-COM-01\nInvio LOGIN_REQUEST\n{username, password}" as COM01
    usecase "UC-COM-02\nRicezione LOGIN_RESPONSE\n{success|fail, message}" as COM02

    usecase "UC-COM-03\nInvio REGISTER_REQUEST\n{username, password}" as COM03
    usecase "UC-COM-04\nRicezione REGISTER_RESPONSE\n{success|fail, message}" as COM04

    usecase "UC-COM-05\nRicezione CHALLENGE_START\n{text_excerpt, encrypted_words,\ntimeout_seconds}" as COM05

    usecase "UC-COM-06\nInvio CHALLENGE_ANSWER\n{word_guess}" as COM06

    usecase "UC-COM-07\nRicezione CHALLENGE_RESULT\n{winner_username, correct_word,\noutcome: win|loss|draw}" as COM07
}

' === RELAZIONI ===
Client --> COM01
Client --> COM03
Client --> COM06

Server --> COM02
Server --> COM05
Server --> COM07

COM01 ..> COM02 : <<include>>\nrisposta server
COM03 ..> COM04 : <<include>>\nrisposta server
COM05 ..> COM06 : <<extend>>\ngiocatore risponde
COM06 ..> COM07 : <<include>>\nserver elabora e risponde

note right of COM01
  Flusso 1 – Autenticazione:
  CLIENT → SERVER: LOGIN_REQUEST
  SERVER → CLIENT: LOGIN_RESPONSE
end note

note right of COM03
  Flusso 2 – Registrazione:
  CLIENT → SERVER: REGISTER_REQUEST
  SERVER → CLIENT: REGISTER_RESPONSE
end note

note bottom of COM05
  Flusso 3 – Avvio Sfida:
  SERVER → entrambi i CLIENT:
  CHALLENGE_START (quando 2 client autenticati)
end note

note bottom of COM07
  Flusso 4 – Esito:
  SERVER → entrambi i CLIENT:
  CHALLENGE_RESULT
  outcome ∈ {win, loss, draw}
end note

@enduml
