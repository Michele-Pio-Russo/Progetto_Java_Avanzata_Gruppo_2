' ============================================================
'  DIAGRAMMA 1 – Use Case Generale del Sistema
'  Panoramica completa di tutti gli attori e macro-casi d'uso
' ============================================================

@startuml UC_01_Sistema_Generale
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #E8F4FD
    BorderColor #2980B9
    FontColor #1A252F
    ArrowColor #2C3E50
}
skinparam actor {
    BackgroundColor #EBF5FB
    BorderColor #1A5276
    FontColor #1A252F
}
skinparam package {
    BackgroundColor #F4F6F7
    BorderColor #BDC3C7
}

title <b>GuessTheWord – Diagramma dei Casi d'Uso: Vista Generale del Sistema</b>\n<i>Corso JA26 – A.A. 2025/2026</i>

' === ATTORI ===
actor "Amministratore" as Admin
actor "Giocatore" as Player
actor "Server" as Server <<system>>
database "Database\nSQLite" as DB <<system>>

' === SISTEMA ===
rectangle "Sistema GuessTheWord" {

    package "Gestione Accesso" {
        usecase "Login" as UC_Login
        usecase "Registrazione" as UC_Register
    }

    package "Gestione Documenti\n(solo Admin)" {
        usecase "Caricamento Documenti" as UC_LoadDocs
        usecase "Avvio Analisi TF" as UC_AnalyzeDocs
        usecase "Salvataggio Analisi" as UC_SaveAnalysis
        usecase "Caricamento Analisi\nPrecedente" as UC_LoadAnalysis
    }

    package "Gestione Sfida" {
        usecase "Attesa Avversario" as UC_Wait
        usecase "Partecipazione alla Sfida" as UC_Challenge
        usecase "Visualizzazione Esito" as UC_Result
    }

    package "Classifiche e Statistiche" {
        usecase "Visualizzazione Classifiche\n(Admin)" as UC_Leaderboard_Admin
        usecase "Visualizzazione Storico\nPersonale (Client)" as UC_History
    }
}

' === RELAZIONI ATTORE → USE CASE ===
Admin --> UC_Login
Admin --> UC_LoadDocs
Admin --> UC_AnalyzeDocs
Admin --> UC_SaveAnalysis
Admin --> UC_LoadAnalysis
Admin --> UC_Leaderboard_Admin

Player --> UC_Register
Player --> UC_Login
Player --> UC_Wait
Player --> UC_Challenge
Player --> UC_Result
Player --> UC_History

' === SERVER come attore secondario ===
Server --> UC_Login         : valida credenziali
Server --> UC_Register      : registra utente
Server --> UC_Challenge     : coordina sfida
Server --> UC_Result        : notifica esito

' === RELAZIONI TRA USE CASE ===
UC_Challenge ..> UC_Wait   : <<include>>
UC_Result     ..> UC_Challenge : <<include>>

UC_Login      ..> DB : <<usa>>
UC_Register   ..> DB : <<usa>>
UC_Challenge  ..> DB : <<usa>>
UC_Result     ..> DB : <<usa>>

note right of Server
  Il Server è un attore secondario:
  coordina connessioni, sfide,
  autenticazione e persistenza.
  Accede esclusivamente al DB.
end note

@enduml


