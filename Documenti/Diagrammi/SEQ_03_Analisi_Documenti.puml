@startuml SEQ_03_Analisi_Documenti
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequence {
    ArrowColor #2C3E50
    ActorBorderColor #1E8449
    ActorBackgroundColor #D5F5E3
    ParticipantBorderColor #1E8449
    ParticipantBackgroundColor #EAFAF1
    LifeLineBorderColor #BDC3C7
}

title <b>SEQ-03 – Analisi Documenti (UC-A02, UC-A03, UC-A04)</b>\n<i>GuessTheWord | Corso JA26 – A.A. 2025/2026</i>

actor "Amministratore" as Admin
participant "Server UI\n(JavaFX/FXML)" as AdminUI
participant "DocumentService\n(JavaFX Service)" as DocService
participant "TFAnalyzer\n(Stream API)" as TFAnalyzer
participant "AnalysisTask\n(JavaFX Task)" as Task
database "File System\n(.txt, .ser)" as FS

Admin -> AdminUI : seleziona file TXT\ndal filesystem
activate AdminUI

AdminUI -> FS : apre FileChooser\nlegge percorsi file selezionati
activate FS
FS --> AdminUI : lista File
deactivate FS

Admin -> AdminUI : preme "Avvia Analisi"

AdminUI -> DocService : avvia(listaFile)
activate DocService

DocService -> Task : crea e schedula AnalysisTask
activate Task

note right of Task
  RF-SRV-08 [MUST]:
  Esecuzione ASINCRONA via
  JavaFX Service/Task:
  la UI rimane reattiva.
end note

Task -> TFAnalyzer : analizza(file)
activate TFAnalyzer

loop per ogni file
    TFAnalyzer -> FS : legge contenuto file TXT
    activate FS
    FS --> TFAnalyzer : testo grezzo
    deactivate FS

    TFAnalyzer -> TFAnalyzer : tokenizza parole\n(Stream API: filter, map,\ncollect, groupingBy)
    TFAnalyzer -> TFAnalyzer : calcola TF\n(freq. relativa per parola)
end

TFAnalyzer --> Task : Map<String, Double>\n(parola → TF)
deactivate TFAnalyzer

Task --> DocService : risultato analisi
deactivate Task

DocService --> AdminUI : aggiorna UI\n(risultati disponibili)
deactivate DocService

AdminUI --> Admin : mostra risultati\nnella interfaccia

Admin -> AdminUI : preme "Salva Analisi"
AdminUI -> FS : serializza Map<String,Double>\nsu file .ser (ObjectOutputStream)
activate FS
FS --> AdminUI : OK
deactivate FS
AdminUI --> Admin : conferma salvataggio

deactivate AdminUI

@enduml
