@startuml CD_01_Architettura_Generale
!theme plain
skinparam backgroundColor #FAFAFA
skinparam class {
    BackgroundColor #EBF5FB
    BorderColor #2980B9
    FontColor #1A252F
    ArrowColor #2C3E50
    HeaderBackgroundColor #2980B9
    HeaderFontColor #FFFFFF
}
skinparam package {
    BackgroundColor #F4F6F7
    BorderColor #85929E
    FontStyle bold
}
skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #B7950B
}

title <b>CD-01 – Class Diagram: Architettura Generale del Sistema</b>\n<i>GuessTheWord | Corso JA26 – A.A. 2025/2026</i>

' =========================================================
' PACKAGE COMMON (condiviso tra server e client)
' =========================================================
package "common" #F0F3F4 {

    class Message <<Serializable>> {
        - type : MessageType
        - payload : Map<String, String>
        + getMessage(key: String) : String
        + setMessage(key: String, val: String) : void
        + getType() : MessageType
    }

    enum MessageType {
        LOGIN_REQUEST
        LOGIN_RESPONSE
        REGISTER_REQUEST
        REGISTER_RESPONSE
        CHALLENGE_START
        CHALLENGE_ANSWER
        CHALLENGE_RESULT
        WAITING
        ERROR
    }

    class User <<Serializable>> {
        - userId : int
        - username : String
        - passwordHash : String
        - role : Role
        - createdAt : LocalDateTime
        + getUsername() : String
        + getRole() : Role
        + isAdmin() : boolean
    }

    enum Role {
        ADMIN
        PLAYER
    }

    class ChallengeData <<Serializable>> {
        - challengeId : int
        - textExcerpt : String
        - encryptedWord : String
        - originalWord : String
        - caesarShift : int
        - timeoutSeconds : int
        - playedAt : LocalDateTime
        + getEncryptedWord() : String
        + getOriginalWord() : String
        + getTimeoutSeconds() : int
    }

    class Result <<Serializable>> {
        - resultId : int
        - challengeId : int
        - userId : int
        - outcome : Outcome
        - responseTimeMs : long
        + getOutcome() : Outcome
        + getResponseTimeMs() : long
    }

    enum Outcome {
        WIN
        LOSS
        DRAW
    }

    Message --> MessageType
    User --> Role
    Result --> Outcome
}

' =========================================================
' PACKAGE SERVER
' =========================================================
package "server" #EAF7EA {

    class ServerApp <<JavaFX Application>> {
        - serverSocket : ServerSocket
        - port : int
        - connectedClients : List<ClientHandler>
        + start(stage: Stage) : void
        + main(args: String[]) : void
        - loadConfig() : void
        - startListening() : void
    }

    class AdminController <<FXML Controller>> {
        - analysisList : ListView<String>
        - statusLabel : Label
        - documentService : DocumentService
        - statsService : StatsService
        + onLoadDocuments() : void
        + onStartAnalysis() : void
        + onSaveAnalysis() : void
        + onLoadAnalysis() : void
        + onShowLeaderboard() : void
    }

    class ClientHandler implements Runnable {
        - socket : Socket
        - in : ObjectInputStream
        - out : ObjectOutputStream
        - user : User
        - challengeManager : ChallengeManager
        + run() : void
        + sendMessage(msg: Message) : void
        + getUser() : User
        - handleLogin(msg: Message) : void
        - handleRegister(msg: Message) : void
        - handleAnswer(msg: Message) : void
    }

    class ChallengeManager {
        - waitingClient : ClientHandler
        - analysisResults : Map<String, Double>
        + registerClient(handler: ClientHandler) : void
        + startChallenge(c1: ClientHandler, c2: ClientHandler) : void
        - selectExcerpt() : String
        - selectWord(excerpt: String) : String
        + broadcastResult(result: ChallengeResult) : void
    }

    class ChallengeBuilder {
        - analysisMap : Map<String, Double>
        + build(excerpt: String) : ChallengeData
        - pickWord(excerpt: String) : String
    }

    class DocumentService <<JavaFX Service>> {
        - files : List<File>
        - analysisSavePath : String
        + setFiles(files: List<File>) : void
        + createTask() : Task<Map<String,Double>>
        + saveAnalysis(map: Map<String,Double>) : void
        + loadAnalysis() : Map<String, Double>
    }

    class TFAnalysisTask <<JavaFX Task>> {
        - files : List<File>
        + call() : Map<String, Double>
        - computeTF(text: String) : Map<String, Double>
    }

    class CaesarCipher {
        + {static} encrypt(word: String, shift: int) : String
        + {static} decrypt(word: String, shift: int) : String
        + {static} randomShift() : int
    }

    class AuthService {
        - dbManager : DBManager
        + authenticate(username: String, password: String) : User
        + register(username: String, password: String) : boolean
        - hashPassword(password: String) : String
    }

    class StatsService {
        - dbManager : DBManager
        + getLeaderboard() : List<UserStats>
        + getUserHistory(userId: int) : List<Result>
    }

    class DBManager {
        - connection : Connection
        - dbPath : String
        + getInstance() : DBManager
        + initSchema() : void
        + insertUser(user: User) : boolean
        + findUser(username: String) : User
        + insertChallenge(data: ChallengeData) : int
        + insertResult(result: Result) : void
        + getLeaderboard() : List<UserStats>
        + getUserResults(userId: int) : List<Result>
    }

    class ConfigLoader {
        + {static} load(filename: String) : Properties
        + {static} getPort(props: Properties) : int
    }

    ' Relazioni server
    ServerApp *-- ClientHandler
    ServerApp --> AdminController
    ServerApp --> ChallengeManager
    ServerApp --> ConfigLoader
    ServerApp --> DBManager

    ClientHandler --> AuthService
    ClientHandler --> ChallengeManager
    ClientHandler --> Message

    ChallengeManager --> ChallengeBuilder
    ChallengeManager --> DBManager

    ChallengeBuilder --> CaesarCipher
    ChallengeBuilder --> ChallengeData

    AdminController --> DocumentService
    AdminController --> StatsService

    DocumentService --> TFAnalysisTask
    AuthService --> DBManager
    StatsService --> DBManager
}

' =========================================================
' PACKAGE CLIENT
' =========================================================
package "client" #FEF9E7 {

    class ClientApp <<JavaFX Application>> {
        - serverIp : String
        - serverPort : int
        - socket : Socket
        - networkService : NetworkService
        + start(stage: Stage) : void
        + main(args: String[]) : void
        - loadConfig() : void
    }

    class LoginController <<FXML Controller>> {
        - usernameField : TextField
        - passwordField : PasswordField
        - loginButton : Button
        - registerButton : Button
        - networkService : NetworkService
        + onLogin() : void
        + onRegister() : void
    }

    class GameController <<FXML Controller>> {
        - textArea : TextArea
        - answerField : TextField
        - sendButton : Button
        - timerLabel : Label
        - statusLabel : Label
        - timeline : Timeline
        - networkService : NetworkService
        + initChallenge(data: ChallengeData) : void
        + onSendAnswer() : void
        + showResult(msg: Message) : void
        - startTimer(seconds: int) : void
    }

    class HistoryController <<FXML Controller>> {
        - historyTable : TableView<Result>
        - networkService : NetworkService
        + loadHistory() : void
    }

    class NetworkService {
        - socket : Socket
        - in : ObjectInputStream
        - out : ObjectOutputStream
        - messageListener : Consumer<Message>
        + connect(ip: String, port: int) : void
        + send(msg: Message) : void
        + setOnMessage(listener: Consumer<Message>) : void
        + startListening() : void
    }

    ' Relazioni client
    ClientApp --> LoginController
    ClientApp --> NetworkService
    ClientApp --> ConfigLoader

    LoginController --> NetworkService
    GameController --> NetworkService
    HistoryController --> NetworkService

    LoginController ..> GameController : naviga a
    GameController ..> HistoryController : naviga a
}

' =========================================================
' RELAZIONI TRA PACKAGE
' =========================================================
ClientHandler ..> Message : usa
NetworkService ..> Message : usa
ChallengeData ..> common
Result ..> common
User ..> common

note bottom of DBManager
  Singleton pattern.
  Accesso esclusivo via JDBC (SQLite).
  Percorsi relativi (RNF-PRT-03).
end note

note top of TFAnalysisTask
  RF-SRV-07 [MUST]: usa Stream API.
  RF-SRV-08 [MUST]: estende JavaFX Task
  per esecuzione asincrona non bloccante.
end note

@enduml
