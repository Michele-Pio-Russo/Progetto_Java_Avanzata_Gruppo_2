@startuml UC_03_Giocatore
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Diagramma 3 — Casi d'Uso: Giocatore

actor "Giocatore" as Player
actor "Sistema\n(Server)" as Server

rectangle "Applicazione Client — IndovinaLaParola" {

  usecase "UC-G01\nRegistrazione" as G01
  usecase "Invio REGISTER_REQUEST\nal server" as G01a
  usecase "Verifica unicita'\nnomeUtente" as G01b

  usecase "UC-G02\nLogin" as G02
  usecase "Invio LOGIN_REQUEST\nal server" as G02a
  usecase "Ricezione LOGIN_RESPONSE\ne navigazione" as G02b

  usecase "UC-G03\nAttesa avversario" as G03
  usecase "Ricezione WAITING\n(1/2 → 2/2)" as G03a

  usecase "UC-G04\nPartecipazione sfida" as G04
  usecase "Visualizzazione\ntesto cifrato" as G04a
  usecase "Timer countdown\n(Timeline JavaFX)" as G04b
  usecase "Inserimento e invio\nrisposta (CHALLENGE_ANSWER)" as G04c

  usecase "UC-G05\nVisualizzazione esito\n(CHALLENGE_RESULT)" as G05

  usecase "UC-G06\nStorico partite\npersonali" as G06

  usecase "UC-G07\nNuova partita\n(REQUEUE_REQUEST)" as G07
}

Player --> G01
Player --> G02
Player --> G03
Player --> G04
Player --> G05
Player --> G06
Player --> G07

Server --> G02 : valida credenziali
Server --> G03 : invia WAITING
Server --> G04 : invia CHALLENGE_START
Server --> G05 : invia CHALLENGE_RESULT

G01 ..> G01a : <<include>>
G01 ..> G01b : <<include>>
G02 ..> G02a : <<include>>
G02 ..> G02b : <<include>>
G03 ..> G03a : <<include>>
G04 ..> G04a : <<include>>
G04 ..> G04b : <<include>>
G04 ..> G04c : <<include>>

G02 ..> G03 : <<extend>>\ndopo login OK
G03 ..> G04 : <<extend>>\nquando entrambi connessi
G04 ..> G05 : <<extend>>\nalla ricezione CHALLENGE_RESULT
G05 ..> G07 : <<extend>>\npulsante "Nuova partita"
G05 ..> G06 : <<extend>>\npulsante "Vedi storico"

note right of G04b
  RF-CLT-07 [MUST]:
  Timeline con KeyFrame ogni secondo
  sul FX Application Thread.
  Ultimi 10s visualizzati in rosso.
end note

note bottom of G07
  REQUEUE_REQUEST inviato sulla
  stessa connessione TCP gia' aperta.
  Il server chiama
  CoordinatoreGioco.gestisciNuovaRichiesta()
end note

@enduml
