@startuml UC_03_Giocatore
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Casi d'Uso - Giocatore

actor "Giocatore" as Player
actor "Sistema\n(Server)" as Server

rectangle "Applicazione Client — IndovinaLaParola" {

  usecase "Registrazione" as G01
  usecase "Invio REGISTER_REQUEST\nal server" as G01a
  usecase "Verifica unicita'\nnomeUtente" as G01b

  usecase "Login" as G02
  usecase "Invio LOGIN_REQUEST\nal server" as G02a
  usecase "Ricezione LOGIN_RESPONSE\ne navigazione" as G02b

  usecase "Attesa avversario" as G03
  usecase "Ricezione WAITING" as G03a

  usecase "Partecipazione sfida" as G04
  usecase "Visualizzazione\ntesto cifrato" as G04a
  usecase "Timer countdown\n(Timeline)" as G04b
  usecase "Inserimento e invio\nrisposta (CHALLENGE_ANSWER)" as G04c

  usecase "Visualizzazione esito" as G05

  usecase "Storico partite\npersonali" as G06

  usecase "Nuova partita" as G07
}

Player --> G01
Player --> G02
Player --> G03
Player --> G04
Player --> G05
Player --> G06
Player --> G07

Server --> G02 : valida credenziali
Server --> G03 : invia WAITING
Server --> G04 : invia CHALLENGE_START
Server --> G05 : invia CHALLENGE_RESULT

G01 ..> G01a : <<include>>
G01 ..> G01b : <<include>>
G02 ..> G02a : <<include>>
G02 ..> G02b : <<include>>
G03 ..> G03a : <<include>>
G04 ..> G04a : <<include>>
G04 ..> G04b : <<include>>
G04 ..> G04c : <<include>>

G02 ..> G03 : <<extend>>\ndopo login OK
G03 ..> G04 : <<extend>>\nquando entrambi connessi
G04 ..> G05 : <<extend>>\nalla ricezione CHALLENGE_RESULT
G05 ..> G07 : <<extend>>\npulsante "Nuova partita"
G05 ..> G06 : <<extend>>\npulsante "Vedi storico"

note right of G04b
  Il timer countdown è gestito tramite una
  Timeline JavaFX con KeyFrame ogni secondo.
  Gli ultimi 10 secondi vengono colorati in rosso.
end note

note bottom of G07
  La richiesta di nuova partita viene inviata sulla
  stessa connessione TCP aperta, senza dover rieseguire il login.
end note

@enduml
