@startuml UC_03_Giocatore
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor Black
}

title UC_03 — Casi d'Uso Giocatore

actor "Giocatore" as G
actor "Server" as S

rectangle "Modulo Giocatore" {
  usecase "UC-G01\nRegistrazione" as UCG01
  usecase "UC-G02\nLogin" as UCG02
  usecase "UC-G03\nAttesa partita" as UCG03
  usecase "UC-G04\nPartecipazione sfida" as UCG04
  usecase "UC-G05\nVisualizzazione esito" as UCG05
  usecase "UC-G06\nNuova partita" as UCG06
  usecase "UC-G07\nStorico partite" as UCG07
  usecase "UC-G08\nRitorno da storico" as UCG08

  usecase "Validare campi\n(username/password)" as UCG_VAL
  usecase "Invio REGISTER_REQUEST /\nLOGIN_REQUEST" as UCG_SEND
  usecase "Ricezione WAITING" as UCG_WAIT
  usecase "Ricezione CHALLENGE_START\ne avvio Timeline" as UCG_START
  usecase "Invio CHALLENGE_ANSWER" as UCG_ANSWER
  usecase "Ricezione CHALLENGE_RESULT" as UCG_RESULT
  usecase "Invio REQUEUE_REQUEST" as UCG_REQUEUE
  usecase "Invio HISTORY_REQUEST" as UCG_HIST
}

G -- UCG01
G -- UCG02
G -- UCG03
G -- UCG04
G -- UCG05
G -- UCG06
G -- UCG07
G -- UCG08

S -- UCG_WAIT
S -- UCG_START
S -- UCG_RESULT

UCG01 ..> UCG_VAL  : <<include>>
UCG02 ..> UCG_VAL  : <<include>>
UCG01 ..> UCG_SEND : <<include>>
UCG02 ..> UCG_SEND : <<include>>

UCG02 ..> UCG03 : <<extend>>\n(se ruolo=player)
UCG03 ..> UCG_WAIT : <<include>>

UCG04 ..> UCG_START  : <<include>>
UCG04 ..> UCG_ANSWER : <<include>>

UCG05 ..> UCG_RESULT : <<include>>
UCG06 ..> UCG_REQUEUE : <<include>>
UCG08 ..> UCG_REQUEUE : <<include>>

UCG07 ..> UCG_HIST : <<include>>

note right of UCG01
  Username >= 3 caratteri,
  password >= 4 caratteri,
  conferma password == password.
end note

note right of UCG03
  IF-S23/IF-S24: accodamento in
  giocatoriInAttesa (ArrayList
  sincronizzato); quando si
  raggiungono 2 elementi il
  server avvia automaticamente
  la sfida.
end note

note bottom of UCG06
  Dalla schermata risultato il
  giocatore preme "Nuova partita":
  REQUEUE_REQUEST sulla stessa
  connessione, senza nuovo login.
end note
@enduml
