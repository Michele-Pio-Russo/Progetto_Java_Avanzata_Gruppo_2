@startuml UC_06_Configurazione
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Diagramma 6 — Casi d'Uso: Configurazione e Avvio del Sistema

actor "Amministratore\n/ Revisore" as Admin
actor "Giocatore" as Player
actor "JVM" as JVM

rectangle "Avvio Server — ApplicazioneServer" {
  usecase "Avvio server\njava -jar server.jar" as UC_SrvStart
  usecase "Lettura\nserver.properties\n(server.porta)" as UC_SrvProp
  usecase "GestoreDatabase\n.getInstance().connetti()\n(initSchema + seedAccounts)" as UC_DBInit
  usecase "ReteServer.start()\napertura ServerSocket\nthread daemon di ascolto" as UC_Socket
  usecase "Caricamento analisi .dat\n(AnalizzatoreDocumenti\n.loadFromFile — se presente)" as UC_LoadDat
  usecase "Avvio ControllerServer\n(JavaFX FXML — server.fxml)" as UC_AdminUI
}

rectangle "Avvio Client — ApplicazioneClient" {
  usecase "Avvio client\njava -jar client.jar" as UC_CltStart
  usecase "Lettura\nclient.properties\n(server.ip, server.porta)" as UC_CltProp
  usecase "ConnessioneServer\n.connetti(ip, porta)\nthread daemon di lettura" as UC_Connect
  usecase "Avvio ControllerAccesso\n(JavaFX FXML — login.fxml)" as UC_LoginUI
}

Admin  --> UC_SrvStart
Admin  --> UC_CltStart
Player --> UC_CltStart
JVM    --> UC_SrvStart
JVM    --> UC_CltStart

UC_SrvStart ..> UC_SrvProp  : <<include>>
UC_SrvStart ..> UC_DBInit   : <<include>>
UC_SrvStart ..> UC_Socket   : <<include>>
UC_SrvStart ..> UC_AdminUI  : <<include>>
UC_SrvStart ..> UC_LoadDat  : <<extend>>\nse file .dat esiste

UC_CltStart ..> UC_CltProp  : <<include>>
UC_CltStart ..> UC_Connect  : <<include>>
UC_CltStart ..> UC_LoginUI  : <<include>>

note right of UC_SrvProp
  RF-SRV-01 [MUST]:
  CaricatoreConfigurazione
  ("properties/server.properties")
  chiave: server.porta = 5000
  Percorso relativo (RNF-PRT-03).
end note

note right of UC_CltProp
  RF-CLT-01 [MUST]:
  ConfigurazioneClient
  ("properties/client.properties")
  server.ip = 127.0.0.1
  server.porta = 5000
end note

note bottom of UC_Socket
  RF-SRV-02 [MUST]:
  ServerSocket in ascolto continuo.
  Thread daemon: non blocca la JVM.
  Ogni Socket accettato crea
  un nuovo GestoreClient.
end note

note bottom of UC_Connect
  Ordine OOS prima di OIS + flush()
  obbligatorio (Modulo 7 - Networking):
  evita deadlock tra costruttori
  ObjectInputStream/ObjectOutputStream.
end note

@enduml
