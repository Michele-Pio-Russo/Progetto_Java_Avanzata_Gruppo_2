@startuml UC_06_Configurazione
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}

title Casi d'Uso - Configurazione

actor "Amministratore\n/ Revisore" as Admin
actor "Giocatore" as Player
actor "JVM" as JVM

rectangle "Avvio Server — ApplicazioneServer" {
  usecase "Avvio server\njava -jar server.jar" as UC_SrvStart
  usecase "Lettura\nserver.properties\n(server.porta)" as UC_SrvProp
  usecase "Inizializzazione database\n(schema e account di test)" as UC_DBInit
  usecase "Apertura ServerSocket\nin ascolto continuo" as UC_Socket
  usecase "Caricamento analisi .dat\n(se presente)" as UC_LoadDat
  usecase "Avvio interfaccia grafica\n(server.fxml)" as UC_AdminUI
}

rectangle "Avvio Client — ApplicazioneClient" {
  usecase "Avvio client\njava -jar client.jar" as UC_CltStart
  usecase "Lettura\nclient.properties\n(ip e porta)" as UC_CltProp
  usecase "Apertura connessione\ne thread di ascolto" as UC_Connect
  usecase "Avvio interfaccia login\n(login.fxml)" as UC_LoginUI
}

Admin  --> UC_SrvStart
Admin  --> UC_CltStart
Player --> UC_CltStart
JVM    --> UC_SrvStart
JVM    --> UC_CltStart

UC_SrvStart ..> UC_SrvProp  : <<include>>
UC_SrvStart ..> UC_DBInit   : <<include>>
UC_SrvStart ..> UC_Socket   : <<include>>
UC_SrvStart ..> UC_AdminUI  : <<include>>
UC_SrvStart ..> UC_LoadDat  : <<extend>>\nse file .dat esiste

UC_CltStart ..> UC_CltProp  : <<include>>
UC_CltStart ..> UC_Connect  : <<include>>
UC_CltStart ..> UC_LoginUI  : <<include>>

note right of UC_SrvProp
  Carica la porta del server dal file
  "properties/server.properties"
  (chiave: server.porta, valore di default 5000).
end note

note right of UC_CltProp
  Carica IP e porta a cui connettersi
  dal file "properties/client.properties".
end note

note bottom of UC_Socket
  Apre la ServerSocket per ricevere connessioni.
  Usa un thread daemon in background che
  crea un GestoreClient per ogni client connesso.
end note

note bottom of UC_Connect
  Inizializza prima ObjectOutputStream (con flush)
  e poi ObjectInputStream per evitare deadlock di rete.
end note

@enduml
